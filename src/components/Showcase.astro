---
import { Picture } from 'astro:assets';
import Phone from './Phone.astro';
import catalog from '../assets/shots/shell-catalog.png';
import variants from '../assets/shots/product-create-variants.png';
import payments from '../assets/shots/payments-list.png';
import orders from '../assets/shots/orders-list.png';
import ttn from '../assets/shots/order-ttn.png';
import analytics from '../assets/shots/analytics.png';
import customers from '../assets/shots/customers.png';
import promos from '../assets/shots/promos.png';
import campaigns from '../assets/shots/campaigns.png';
import appearance from '../assets/shots/appearance.png';

// Real product screens (docshots demo data). On wide screens the phone stays put and
// its screen changes as each feature reaches the middle of the viewport.
const cards = [
  { img: catalog, who: 'Покупець', title: 'Вітрина як у застосунку', text: 'Категорії, пошук, фото, знижки й кошик відкриваються прямо в Telegram.', alt: 'Каталог магазину з категоріями і кнопками додавання в кошик' },
  { img: variants, who: 'Ви', title: 'Розміри й кольори варіантами', text: 'Залишок по кожному варіанту і до 10 фото. Стара ціна закреслюється сама.', alt: 'Форма товару з варіантами розмірів і фото' },
  { img: payments, who: 'Ви', title: 'П’ять способів оплати', text: 'LiqPay і plata by mono з автопідтвердженням, а також реквізити, посилання і післяплата.', alt: 'Налаштування способів оплати: LiqPay, plata by mono, оплата за посиланням' },
  { img: orders, who: 'Ви', title: 'Видно, що чекає на вас', text: 'Фільтри «Очікують», «На перевірці», «До відправки», «У дорозі» з лічильниками.', alt: 'Список замовлень з фільтрами за статусом' },
  { img: ttn, who: 'Ви', title: 'ТТН з картки замовлення', text: 'Дані покупця вже в замовленні. Створіть накладну, оновіть статус і відстежте посилку.', alt: 'Картка замовлення зі створеною ТТН Нової пошти' },
  { img: analytics, who: 'Ви', title: 'Виторг, чек і конверсія', text: 'Порівняння з попереднім періодом, топ товарів і підказки, що перевірити.', alt: 'Аналітика: виторг, замовлення, середній чек, конверсія' },
  { img: customers, who: 'Ви', title: 'Клієнти й сегменти', text: 'Нові, повторні, VIP і ті, хто давно не купував. Напишіть клієнту з його картки.', alt: 'База клієнтів з пошуком і сегментами' },
  { img: promos, who: 'Ви', title: 'Промокоди для своїх', text: 'Відсоток або сума, ліміт використань і аудиторія: лише нові, повторні чи VIP.', alt: 'Список промокодів зі статусами' },
  { img: campaigns, who: 'Ви', title: 'Розсилки від вашого бота', text: 'Повідомлення сегменту клієнтів і звіт: скільки доставлено, скільки помилок.', alt: 'Історія розсилок з показниками доставки' },
  { img: appearance, who: 'Ви', title: 'Магазин у вашому стилі', text: 'Шаблон, кольори, шрифт, банер і біжучий рядок. Зміни видно у вітрині одразу.', alt: 'Редактор вигляду магазину' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="stage showcase" id="features" aria-labelledby="showcase-title" data-stage data-showcase>
  <div class="container">
    <div class="sc-head">
      <p class="sc-eyebrow">Справжні екрани Cartium</p>
      <h2 id="showcase-title" class="display h2">Від вітрини до аналітики. В одному боті.</h2>
      <p class="lead">Без макетів: так ваш магазин бачать покупці і так ним керуєте ви.</p>
    </div>

    <div class="sc-grid">
      <ol class="sc-list" data-sc-list>
        {cards.map((c, i) => (
          <li class:list={['sc-item', { 'is-active': i === 0 }]} data-sc-item={i}>
            <div class="sc-inline">
              <Phone src={c.img} alt={c.alt} width={260} sizes="(max-width: 640px) 64vw, 260px" />
            </div>
            <p class="sc-meta">
              <span class="sc-num">{pad(i + 1)}</span>
              <span class:list={['sc-who', { 'is-buyer': c.who === 'Покупець' }]}>{c.who}</span>
            </p>
            <h3 class="sc-title">{c.title}</h3>
            <p class="sc-text">{c.text}</p>
          </li>
        ))}
      </ol>

      <div class="sc-aside" aria-hidden="true">
        <div class="sc-sticky">
          <div class="sc-device">
            <div class="sc-bezel">
              {cards.map((c, i) => (
                <div class:list={['sc-shot', { 'is-on': i === 0 }]} data-sc-shot={i} style={`--i:${i}`}>
                  <Picture
                    src={c.img}
                    alt=""
                    widths={[300, 450, 600]}
                    sizes="300px"
                    formats={['avif', 'webp']}
                    quality={78}
                    loading={i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
              ))}
            </div>
          </div>
          <div class="sc-meter">
            <span class="sc-count"><span data-sc-count>01</span> / {pad(cards.length)}</span>
            <span class="sc-bar"><span data-sc-bar></span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase {
    padding-block: var(--section-y);
    overflow-x: clip;
  }
  .sc-head {
    display: grid;
    gap: 20px;
    max-width: 820px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .sc-eyebrow {
    color: var(--muted);
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .sc-head .h2 {
    font-size: clamp(2.3rem, 1.2rem + 3.6vw, 4.4rem);
    letter-spacing: -0.045em;
  }

  .sc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
  }

  /* Feature list: each item owns a slice of scroll. */
  .sc-item {
    min-height: 62vh;
    display: grid;
    align-content: center;
    gap: 14px;
    max-width: 30rem;
    opacity: 0.28;
    transition: opacity 0.6s var(--ease-out);
  }
  .sc-item.is-active {
    opacity: 1;
  }
  .sc-item:first-child {
    min-height: 48vh;
    align-content: start;
  }
  .sc-item:last-child {
    min-height: 56vh;
  }
  .sc-inline {
    display: none;
  }
  .sc-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sc-num {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .sc-who {
    padding: 4px 12px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink-2);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .sc-who.is-buyer {
    background: var(--ink);
    color: var(--bg);
    box-shadow: none;
  }
  .sc-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 1.1rem + 2vw, 2.8rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .sc-text {
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* The pinned phone. */
  .sc-aside {
    --dw: min(310px, calc((100dvh - 200px) * 0.5228));
    position: relative;
  }
  .sc-sticky {
    position: sticky;
    top: calc(50dvh - var(--dw) * 0.9564 - 24px);
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .sc-sticky::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 10%;
    left: 50%;
    width: calc(var(--dw) * 2.2);
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.1), transparent 70%);
  }
  .sc-device {
    width: var(--dw);
    aspect-ratio: 780 / 1492;
    padding: 7px;
    border-radius: var(--r-phone);
    background: var(--chrome);
    box-shadow:
      inset 0 0 0 1px var(--chrome-edge),
      var(--shadow-phone);
  }
  .sc-bezel {
    position: relative;
    height: 100%;
    padding: 5px;
    border-radius: calc(var(--r-phone) - 7px);
    background: #0a0a0b;
    overflow: hidden;
  }
  .sc-shot {
    position: absolute;
    inset: 5px;
    z-index: var(--i);
    border-radius: calc(var(--r-phone) - 12px);
    overflow: hidden;
    background: #f4f4f6;
    clip-path: inset(100% 0 0 0 round calc(var(--r-phone) - 12px));
    transition: clip-path 0.8s var(--ease-out);
  }
  .sc-shot.is-on {
    clip-path: inset(0 0 0 0 round calc(var(--r-phone) - 12px));
  }
  .sc-shot :global(picture),
  .sc-shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .sc-shot :global(img) {
    object-fit: cover;
    object-position: top;
  }
  .sc-meter {
    display: flex;
    align-items: center;
    gap: 14px;
    width: var(--dw);
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .sc-count {
    flex: none;
    font-family: var(--font-display);
  }
  .sc-count span {
    color: var(--ink);
  }
  .sc-bar {
    flex: 1;
    height: 2px;
    border-radius: 2px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .sc-bar span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0.1);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-shot,
    .sc-item {
      transition: none;
    }
  }

  /* Small screens: a swipeable row of phones with their captions. */
  @media (max-width: 960px) {
    .sc-grid {
      display: block;
    }
    .sc-aside {
      display: none;
    }
    .sc-list {
      display: flex;
      gap: 20px;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .sc-list::-webkit-scrollbar {
      display: none;
    }
    .sc-item,
    .sc-item:first-child,
    .sc-item:last-child {
      flex: none;
      width: min(280px, 74vw);
      min-height: 0;
      align-content: start;
      opacity: 1;
      scroll-snap-align: start;
    }
    .sc-inline {
      display: block;
      margin-bottom: 10px;
    }
    .sc-title {
      font-size: 1.45rem;
    }
    .sc-text {
      font-size: 1rem;
    }
  }
</style>
