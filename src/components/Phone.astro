---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  priority?: boolean;
  eager?: boolean;
  class?: string;
  sizes?: string;
}
const { src, alt, width = 320, priority = false, eager = false, class: className, sizes } = Astro.props;
---
<div class:list={['phone', className]} style={`--phone-w:${width}px`}>
  <div class="phone-bezel">
    <Picture
      src={src}
      alt={alt}
      widths={[width, Math.round(width * 1.5), Math.min(width * 2, src.width)]}
      sizes={sizes ?? `${width}px`}
      formats={['avif', 'webp']}
      quality={78}
      loading={priority || eager ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      class="phone-screen"
    />
  </div>
</div>

<style>
  .phone {
    width: min(var(--phone-w), 100%);
    aspect-ratio: 780 / 1492;
    padding: 7px;
    border-radius: var(--r-phone);
    background: var(--chrome);
    box-shadow:
      inset 0 0 0 1px var(--chrome-edge),
      inset 0 -2px 3px rgba(14, 26, 46, 0.18),
      var(--shadow-phone);
    position: relative;
  }
  .phone-bezel {
    height: 100%;
    padding: 5px;
    border-radius: calc(var(--r-phone) - 7px);
    background: #0b0f17;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .phone-bezel :global(picture),
  .phone-bezel :global(img) {
    width: 100%;
    height: 100%;
  }
  .phone-bezel :global(img) {
    object-fit: cover;
    object-position: top;
    border-radius: calc(var(--r-phone) - 12px);
    background: #f4f5f7;
  }
</style>
