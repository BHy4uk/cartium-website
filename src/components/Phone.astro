---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Device from './Device.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  priority?: boolean;
  eager?: boolean;
  class?: string;
  sizes?: string;
}
const { src, alt, width = 320, priority = false, eager = false, class: className, sizes } = Astro.props;
// The screen is about 93% of the device width.
const screenW = Math.round(width * 0.93);
---
<Device width={width} class={className}>
  <Picture
    src={src}
    alt={alt}
    widths={[screenW, Math.round(screenW * 1.5), Math.min(screenW * 2, src.width)]}
    sizes={sizes ?? `${screenW}px`}
    formats={['avif', 'webp']}
    quality={80}
    loading={priority || eager ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class="phone-shot"
  />
</Device>

