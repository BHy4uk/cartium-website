---
import Phone from './Phone.astro';
import catalog from '../assets/shots/shell-catalog.png';
import variants from '../assets/shots/product-create-variants.png';
import payments from '../assets/shots/payments-list.png';
import orders from '../assets/shots/orders-list.png';
import ttn from '../assets/shots/order-ttn.png';
import analytics from '../assets/shots/analytics.png';
import customers from '../assets/shots/customers.png';
import promos from '../assets/shots/promos.png';
import campaigns from '../assets/shots/campaigns.png';
import appearance from '../assets/shots/appearance.png';

const cards = [
  {
    img: catalog,
    who: 'Покупець',
    title: 'Вітрина як у застосунку',
    text: 'Категорії, пошук, фото, знижки й кошик відкриваються прямо в Telegram.',
    alt: 'Каталог магазину з категоріями і кнопками додавання в кошик',
  },
  {
    img: variants,
    who: 'Ви',
    title: 'Розміри й кольори варіантами',
    text: 'Залишок по кожному варіанту і до 10 фото. Стара ціна закреслюється сама.',
    alt: 'Форма товару з варіантами розмірів і фото',
  },
  {
    img: payments,
    who: 'Ви',
    title: 'П’ять способів оплати',
    text: 'LiqPay і plata by mono з автопідтвердженням, а також реквізити, посилання і післяплата.',
    alt: 'Налаштування способів оплати: LiqPay, plata by mono, оплата за посиланням',
  },
  {
    img: orders,
    who: 'Ви',
    title: 'Видно, що чекає на вас',
    text: 'Фільтри «Очікують», «На перевірці», «До відправки», «У дорозі» з лічильниками.',
    alt: 'Список замовлень з фільтрами за статусом',
  },
  {
    img: ttn,
    who: 'Ви',
    title: 'ТТН з картки замовлення',
    text: 'Дані покупця вже в замовленні. Створіть накладну, оновіть статус і відстежте посилку.',
    alt: 'Картка замовлення зі створеною ТТН Нової пошти',
  },
  {
    img: analytics,
    who: 'Ви',
    title: 'Виторг, чек і конверсія',
    text: 'Порівняння з попереднім періодом, топ товарів і підказки, що перевірити.',
    alt: 'Аналітика: виторг, замовлення, середній чек, конверсія',
  },
  {
    img: customers,
    who: 'Ви',
    title: 'Клієнти й сегменти',
    text: 'Нові, повторні, VIP і ті, хто давно не купував. Напишіть клієнту з його картки.',
    alt: 'База клієнтів з пошуком і сегментами',
  },
  {
    img: promos,
    who: 'Ви',
    title: 'Промокоди для своїх',
    text: 'Відсоток або сума, ліміт використань і аудиторія: лише нові, повторні чи VIP.',
    alt: 'Список промокодів зі статусами',
  },
  {
    img: campaigns,
    who: 'Ви',
    title: 'Розсилки від вашого бота',
    text: 'Повідомлення сегменту клієнтів і звіт: скільки доставлено, скільки помилок.',
    alt: 'Історія розсилок з показниками доставки',
  },
  {
    img: appearance,
    who: 'Ви',
    title: 'Магазин у вашому стилі',
    text: 'Шаблон, кольори, шрифт, банер і біжучий рядок. Зміни видно у вітрині одразу.',
    alt: 'Редактор вигляду магазину',
  },
];
---
<section class="gallery" id="features" aria-labelledby="gallery-title" data-gallery>
  <div class="gallery-pin" data-gallery-pin>
    <div class="container gallery-head">
      <h2 id="gallery-title" class="display h2">Справжні екрани Cartium</h2>
      <p class="lead">Від вітрини до аналітики: так ваш магазин бачать покупці і так ним керуєте ви.</p>
    </div>
    <div class="gallery-viewport" data-gallery-viewport>
      <ul class="gallery-track" data-gallery-track>
        {cards.map((c) => (
          <li class="gcard" data-gcard>
            <div class="gcard-phone">
              <Phone src={c.img} alt={c.alt} width={300} sizes="(max-width: 640px) 70vw, 300px" />
            </div>
            <div class="gcard-text">
              <p class="gcard-who">{c.who}</p>
              <h3 class="h3">{c.title}</h3>
              <p class="body-muted">{c.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <div class="container gallery-progress" aria-hidden="true">
      <span class="gallery-bar"><span data-gallery-bar></span></span>
    </div>
  </div>
</section>

<style>
  .gallery {
    position: relative;
    overflow-x: clip;
    padding-block: var(--section-y) calc(var(--section-y) * 0.6);
  }
  .gallery-head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .gallery-head .h2 {
    max-width: 18ch;
  }
  .gallery-pin {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .gallery-viewport {
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .gallery-viewport::-webkit-scrollbar {
    display: none;
  }
  .gallery-track {
    display: flex;
    gap: clamp(24px, 4vw, 56px);
    width: max-content;
    padding-inline: max(var(--gutter), calc((100vw - var(--page-max)) / 2));
    padding-bottom: 12px;
  }
  .gcard {
    width: clamp(240px, 70vw, 300px);
    display: grid;
    gap: 24px;
    align-content: start;
    scroll-snap-align: center;
  }
  .gcard-phone {
    transition: transform 0.7s var(--ease-spring);
  }
  .gcard:hover .gcard-phone {
    transform: translateY(-10px);
  }
  .gcard-text {
    display: grid;
    gap: 8px;
    padding-right: 8px;
  }
  .gcard-who {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-text);
  }
  .gallery-progress {
    margin-top: 32px;
  }
  .gallery-bar {
    display: block;
    height: 3px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
  }
  .gallery-bar span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(0.1);
  }

  /* Desktop motion: the section pins and the track pans with vertical scroll. */
  :global(.gallery-animated) .gallery {
    padding-block: 0;
  }
  :global(.gallery-animated) .gallery-pin {
    height: 100dvh;
    display: grid;
    align-content: center;
    padding-top: calc(var(--nav-h) + 8px);
  }
  :global(.gallery-animated) .gallery-viewport {
    overflow: visible;
    scroll-snap-type: none;
  }
  :global(.gallery-animated) .gallery-head {
    margin-bottom: 40px;
  }
  :global(.gallery-animated) .gcard {
    width: clamp(460px, 40vw, 540px);
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    align-items: end;
    gap: 28px;
  }
  :global(.gallery-animated) .gcard-text {
    padding-bottom: 24px;
  }
  @media (max-height: 860px) {
    :global(.gallery-animated) .gcard {
      width: 440px;
    }
  }
</style>
