---
import Icon from './Icon.astro';
import liqpay from '../assets/logos/liqpay-mark.svg?raw';
import monoDark from '../assets/logos/plata-by-mono-dark.svg?raw';
import appleLight from '../assets/logos/apple-pay-light.svg?raw';
import googleDark from '../assets/logos/google-pay-dark.svg?raw';

const hide = (svg: string) => svg.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<section class="rails" aria-labelledby="rails-title">
  <div class="container rails-inner">
    <p id="rails-title" class="rails-title">Оплата й доставка, якими вже користуються ваші покупці</p>
    <ul class="rails-list">
      <li class="rail rail--liqpay">
        <span class="rail-logo" set:html={hide(liqpay)} />
        <span class="rail-name">LiqPay</span>
      </li>
      <li class="rail rail--mono" aria-label="plata by mono">
        <span class="rail-logo rail-logo--invert" set:html={hide(monoDark)} />
      </li>
      <li class="rail rail--apple" aria-label="Apple Pay">
        <span class="rail-logo rail-logo--glyph" set:html={hide(appleLight)} />
      </li>
      <li class="rail rail--google" aria-label="Google Pay">
        <span class="rail-logo rail-logo--invert" set:html={hide(googleDark)} />
      </li>
      <li class="rail rail--text"><Icon name="paypal-logo" /> PayPal</li>
      <li class="rail rail--text"><Icon name="truck" /> Нова пошта</li>
      <li class="rail rail--text"><Icon name="bank" /> Реквізити IBAN</li>
      <li class="rail rail--text"><Icon name="hand-coins" /> Післяплата</li>
    </ul>
  </div>
</section>

<style>
  .rails {
    padding-block: clamp(48px, 7vw, 88px);
  }
  .rails-inner {
    display: grid;
    gap: clamp(26px, 3vw, 40px);
    justify-items: center;
    text-align: center;
  }
  .rails-title {
    color: var(--muted);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    font-weight: 500;
  }
  /* Eight marks in two even rows of four (two columns on phones), so no row is left half empty. */
  .rails-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-items: center;
    align-items: center;
    gap: clamp(18px, 2.4vw, 32px) clamp(24px, 4vw, 56px);
    width: min(100%, 1000px);
  }
  @media (max-width: 640px) {
    .rails-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 12px;
    }
    .rail-name,
    .rail--text {
      font-size: 1.08rem;
    }
  }
  .rail {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 52px;
    white-space: nowrap;
    color: var(--ink-2);
    opacity: 0.86;
    transition: opacity 0.3s var(--ease-out);
  }
  .rail:hover {
    opacity: 1;
  }
  /* Brand marks in greyscale, so the strip reads as one monochrome line. */
  .rail-logo {
    display: inline-flex;
    filter: grayscale(1);
  }
  .rail-logo :global(svg) {
    height: 34px;
    width: auto;
  }
  .rail--liqpay .rail-logo :global(svg) {
    height: 28px;
  }
  .rail--mono .rail-logo :global(svg) {
    height: 28px;
  }
  .rail-name,
  .rail--text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.45rem);
    letter-spacing: -0.02em;
  }
  .rail--text :global(.icon) {
    font-size: 1.6rem;
  }
  /* plata by mono and Google Pay ship white-on-dark artwork: invert it for the light page. */
  .rail-logo--invert {
    filter: grayscale(1) invert(var(--logo-invert));
  }
  /* Apple Pay's single black glyph: inverted only on the dark theme. */
  .rail-logo--glyph {
    filter: grayscale(1) invert(calc(1 - var(--logo-invert)));
  }
</style>
