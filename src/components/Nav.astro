---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SIGNUP_URL } from '../config';

const links = [
  { href: '#demo', label: 'Демо' },
  { href: '#how', label: 'Запуск' },
  { href: '#features', label: 'Можливості' },
  { href: '#pricing', label: 'Тарифи' },
  { href: '#faq', label: 'Питання' },
];
---
<header class="nav-wrap" data-nav>
  <nav class="nav" aria-label="Головна навігація">
    <a href="#top" class="nav-logo" aria-label="Cartium, на початок сторінки"><Logo /></a>
    <ul class="nav-links">
      {links.map((l) => <li><a href={l.href} class="nav-link">{l.label}</a></li>)}
    </ul>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" aria-label="Темна тема" aria-pressed="false" data-theme-toggle>
        <span class="theme-icon theme-icon--moon"><Icon name="moon" /></span>
        <span class="theme-icon theme-icon--sun"><Icon name="sun" /></span>
      </button>
      <a class="btn btn-primary btn-sm nav-cta" href={SIGNUP_URL} target="_blank" rel="noopener">
        <span>Створити<span class="cta-more"> магазин</span></span>
        <span class="btn-icon"><Icon name="paper-plane-tilt" /></span>
      </a>
      <button class="nav-burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only">Меню</span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
    </div>
    <span class="nav-progress" aria-hidden="true"><span data-nav-progress></span></span>
  </nav>
</header>

<!-- The same progress, standing along the left edge: a hairline that fills as you read, with a
     point of ultraviolet light riding its head (main.ts). -->
<div class="scroll-line" data-scroll-line aria-hidden="true">
  <span class="scroll-line-fill"></span>
  <span class="scroll-line-head"></span>
</div>

<div class="menu" id="mobile-menu" data-menu hidden>
  <ul class="menu-links">
    {links.map((l, i) => (
      <li style={`--i:${i}`}><a href={l.href} class="menu-link" data-menu-link>{l.label}</a></li>
    ))}
  </ul>
  <a class="btn btn-primary menu-cta" href={SIGNUP_URL} target="_blank" rel="noopener" style="--i:4">
    Створити магазин
    <span class="btn-icon"><Icon name="paper-plane-tilt" /></span>
  </a>
</div>

<style>
  .nav-wrap {
    position: fixed;
    inset: 14px 0 auto;
    z-index: var(--z-nav);
    display: flex;
    justify-content: center;
    padding-inline: 12px;
    pointer-events: none;
    transition: transform 0.6s var(--ease-spring);
  }
  .nav-wrap.is-hidden {
    transform: translateY(calc(-100% - 20px));
  }
  .nav {
    position: relative;
    pointer-events: auto;
    width: min(1120px, 100%);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 10px 0 20px;
    border-radius: var(--r-pill);
    background: var(--glass);
    backdrop-filter: saturate(1.6) blur(18px);
    -webkit-backdrop-filter: saturate(1.6) blur(18px);
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 12px 40px -24px rgba(24, 24, 27, 0.3);
  }
  /* How far down the page you are: a violet hairline along the bottom of the pill (main.ts). */
  .nav-progress {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    pointer-events: none;
  }
  .nav-progress span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent, var(--accent) 24%, var(--accent));
    transform: scaleX(0);
    transform-origin: left center;
  }
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease-out),
      transform 0.4s var(--ease-spring);
  }
  .theme-toggle:hover {
    background: var(--hover-soft);
  }
  /* Sun and moon trade places: the outgoing one turns away, shrinks and blurs as the other turns
     in on a spring. */
  .theme-icon {
    grid-area: 1 / 1;
    display: grid;
    font-size: 1.25rem;
    transition:
      transform 0.8s var(--ease-spring),
      opacity 0.4s var(--ease-out),
      filter 0.4s var(--ease-out);
  }
  .theme-icon--sun,
  :global([data-theme='dark']) .theme-icon--moon {
    opacity: 0;
    filter: blur(4px);
    transform: rotate(-120deg) scale(0.4);
  }
  :global([data-theme='dark']) .theme-icon--sun {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .theme-toggle:active {
    transform: scale(0.92);
  }
  .nav-logo {
    display: inline-flex;
    border-radius: 12px;
  }
  .nav-links {
    display: flex;
    gap: 4px;
    margin-inline: auto;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    font-weight: 500;
    font-size: 0.96rem;
    color: var(--ink-2);
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .nav-link:hover {
    background: var(--hover-soft);
    color: var(--ink);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .burger-line {
    position: absolute;
    top: calc(50% - 0.875px);
    left: 13px;
    right: 13px;
    height: 1.75px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.5s var(--ease-spring);
  }
  .burger-line:first-of-type {
    transform: translateY(-4px);
  }
  .burger-line:last-of-type {
    transform: translateY(4px);
  }
  .nav-burger[aria-expanded='true'] .burger-line:first-of-type {
    transform: rotate(45deg);
  }
  .nav-burger[aria-expanded='true'] .burger-line:last-of-type {
    transform: rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) - 1);
    display: grid;
    align-content: center;
    gap: 40px;
    padding: 120px 28px 48px;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }
  .menu[hidden] {
    display: none;
  }
  .menu-links {
    display: grid;
    gap: 6px;
  }
  .menu-link {
    display: block;
    padding: 8px 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 9vw, 2.6rem);
    letter-spacing: -0.03em;
  }
  .menu-links li,
  .menu-cta {
    opacity: 0;
    transform: translateY(24px);
  }
  .menu.is-open .menu-links li,
  .menu.is-open .menu-cta {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out) calc(var(--i) * 60ms + 80ms),
      transform 0.7s var(--ease-spring) calc(var(--i) * 60ms + 80ms);
  }
  .menu-cta {
    justify-self: start;
  }

  @media (max-width: 960px) {
    .nav-links {
      display: none;
    }
    .nav-actions {
      margin-left: auto;
    }
    .nav-burger {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .nav {
      padding-left: 16px;
      gap: 12px;
    }
    .cta-more {
      display: none;
    }
  }

  /* Left progress line. --p (0..1) is eased in main.ts; while the page moves, .is-moving lets the
     head's light swell, then it settles back to a slow breath. */
  .scroll-line {
    --p: 0;
    position: fixed;
    z-index: 30;
    left: clamp(6px, 1.1vw, 18px);
    top: calc(var(--nav-h) + 48px);
    bottom: 48px;
    width: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
    pointer-events: none;
  }
  .scroll-line-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 0%, transparent), var(--accent) 35%, var(--violet-hi));
    box-shadow: 0 0 10px var(--accent-glow);
    transform: scaleY(var(--p));
    transform-origin: top center;
  }
  /* A soft wash of light along the filled part. */
  .scroll-line::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0;
    width: 16px;
    height: calc(var(--p) * 100%);
    border-radius: 8px;
    background: linear-gradient(180deg, transparent, var(--accent-glow));
    filter: blur(8px);
    opacity: 0.55;
  }
  .scroll-line-head {
    position: absolute;
    left: 50%;
    top: calc(var(--p) * 100%);
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--violet-hi);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent),
      0 0 16px 5px var(--accent-glow);
  }
  .scroll-line-head::after {
    content: '';
    position: absolute;
    inset: -18px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--accent-glow), transparent);
    animation: line-breathe 2.8s ease-in-out infinite;
    transition: scale 0.5s var(--ease-out);
  }
  .scroll-line.is-moving .scroll-line-head::after {
    scale: 1.6;
  }
  @keyframes line-breathe {
    50% {
      opacity: 0.45;
      transform: scale(1.35);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-line-head::after {
      animation: none;
      transition: none;
    }
  }
</style>
