---
import Icon from './Icon.astro';
import { SIGNUP_URL, PLANS, TRIAL_DAYS, YEARLY_DISCOUNT } from '../config';

const perMonthYearly = (yearly: number) => yearly / 12;
---
<section class="section pricing" id="pricing" aria-labelledby="pricing-title" data-pricing>
  <div class="container">
    <div class="section-head is-center">
      <h2 id="pricing-title" class="display h2">Фіксована ціна без відсотка з продажів</h2>
      <p class="lead">
        Гроші покупців надходять напряму вам. {TRIAL_DAYS} днів безкоштовно.
      </p>
      <div class="period" role="radiogroup" aria-label="Період оплати">
        <button type="button" class="period-opt" role="radio" aria-checked="true" data-period="monthly">Щомісяця</button>
        <button type="button" class="period-opt" role="radio" aria-checked="false" data-period="yearly">
          За рік <span class="period-save">−{YEARLY_DISCOUNT}%</span>
        </button>
      </div>
    </div>

    <div class="plans glow-host" data-plans>
      <div class="aura glow" data-glow-for=".plan--featured" aria-hidden="true"></div>
      {PLANS.map((p) => (
        <article class:list={['plan spot', { 'plan--featured stage is-on': p.badge }]} aria-labelledby={`plan-${p.id}`} data-plan>
          <span class="plan-light" aria-hidden="true"></span>
          <div class="plan-body">
          <header class="plan-head">
            <div class="plan-title-row">
              <h3 id={`plan-${p.id}`} class="plan-name">{p.name}</h3>
              {p.badge && <span class="plan-badge">{p.badge}</span>}
            </div>
            <p class="plan-tagline">{p.tagline}</p>
          </header>

          <div class="plan-price">
            <span class="price-cur">$</span>
            <span
              class="price-num"
              data-price
              data-monthly={p.monthly}
              data-yearly={perMonthYearly(p.yearly)}
            >{p.monthly}</span>
            <span class="price-per">/ міс</span>
          </div>
          <p class="plan-billed" data-billed data-monthly-text="оплата щомісяця" data-yearly-text={`$${p.yearly} за рік, економія $${p.monthly * 12 - p.yearly}`}>
            оплата щомісяця
          </p>

          {p.includes && <p class="plan-includes">{p.includes}</p>}
          <ul class="plan-features">
            {p.features.map((f) => (
              <li><Icon name="check" /> {f}</li>
            ))}
          </ul>
          </div>

          <!-- The choice rises out of the card's foot when the card is lit (hover, focus, or Pro at rest). -->
          <div class="plan-pick">
            <a class="btn plan-btn" href={SIGNUP_URL} target="_blank" rel="noopener">
              Обрати {p.name}
              <span class="btn-icon"><Icon name="arrow-right" /></span>
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="pricing-note">
      Картка для пробного періоду не потрібна, тож нічого не спишеться автоматично. Пробний період відкриває
      можливості Basic, а тариф можна змінити будь-коли в розділі «Налаштування → Підписка».
    </p>
  </div>
</section>

<style>
  .period {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    margin-top: 8px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .period-opt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    border-radius: var(--r-pill);
    font-weight: 600;
    color: var(--muted);
    transition: background-color 0.4s var(--ease-out), color 0.3s var(--ease-out);
  }
  .period-opt[aria-checked='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .period-save {
    padding: 2px 8px;
    border-radius: var(--r-pill);
    background: var(--ok-soft);
    color: var(--ok);
    font-size: 0.8rem;
  }
  .period-opt[aria-checked='true'] .period-save {
    background: rgba(255, 255, 255, 0.16);
    color: inherit;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--r-card);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .plan--featured {
    color: var(--ink);
    border: 1px solid transparent;
    background:
      radial-gradient(120% 70% at 50% 0%, var(--aura), transparent 62%) padding-box,
      linear-gradient(var(--stage-bg), var(--stage-bg)) padding-box,
      linear-gradient(160deg, color-mix(in srgb, var(--violet-hi) 80%, transparent), rgba(255, 255, 255, 0.06) 40%, rgba(255, 255, 255, 0.1) 70%, color-mix(in srgb, var(--violet-hi) 40%, transparent)) border-box;
    box-shadow: 0 2px 4px rgba(24, 24, 27, 0.08), 0 60px 100px -50px var(--accent-glow);
    transform: translateY(-12px);
  }
  .plan-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .plan-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }
  .plan-badge {
    padding: 4px 12px;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .plan-tagline {
    color: var(--muted);
  }
  .plan--featured .plan-tagline,
  .plan--featured .plan-billed,
  .plan--featured .plan-includes {
    color: var(--muted);
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-top: 6px;
    font-family: var(--font-display);
  }
  .price-cur {
    font-size: 1.6rem;
    font-weight: 600;
    align-self: flex-start;
    margin-top: 0.35em;
  }
  .price-num {
    font-size: clamp(3.4rem, 2.8rem + 2vw, 4.4rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    min-width: 2ch;
  }
  .price-per {
    color: var(--muted);
    font-family: var(--font-text);
    font-weight: 500;
  }
  .plan--featured .price-per {
    color: var(--muted);
  }
  .plan-billed {
    margin-top: -10px;
    font-size: 0.92rem;
    color: var(--muted);
    min-height: 1.5em;
  }
  /* ---- The lit card ----
     One card at a time is "on": Pro at rest, otherwise the one under the pointer or keyboard focus
     (main.ts). Light pours in from the top edge, the content floats up a touch, and the choice rises
     out of the card's foot with a sweep of light across it. */
  .plan {
    --plan-light: color-mix(in srgb, var(--violet) 26%, transparent);
  }
  :global([data-theme='dark']) .plan,
  .plan--featured {
    --plan-light: color-mix(in srgb, var(--violet) 58%, transparent);
  }
  .plan-light {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .plan-light::before {
    content: '';
    position: absolute;
    left: -15%;
    right: -15%;
    top: -42%;
    height: 90%;
    background: radial-gradient(50% 50% at 50% 50%, var(--plan-light), transparent);
    transform: scale(0.6, 0.4);
    transform-origin: 50% 0;
    transition: transform 0.9s var(--ease-spring);
  }
  .plan-light::after {
    content: '';
    position: absolute;
    top: 0;
    left: 14%;
    right: 14%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--violet-hi), transparent);
    transform: scaleX(0.3);
    transition: transform 0.9s var(--ease-spring);
  }
  .plan.is-on .plan-light {
    opacity: 1;
  }
  .plan.is-on .plan-light::before,
  .plan.is-on .plan-light::after {
    transform: none;
  }
  .plan-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: transform 0.8s var(--ease-spring);
  }
  .plan.is-on .plan-body {
    transform: translateY(-6px);
  }
  .plan-pick {
    margin-top: auto;
    padding-top: 10px;
  }
  /* Ultraviolet from deep to bright, the site's one accent, read left to right. */
  .plan .plan-btn {
    width: 100%;
    justify-content: space-between;
    padding-right: 8px;
    color: #fff;
    background: linear-gradient(100deg, color-mix(in oklab, var(--violet) 72%, #0d0630), var(--violet) 45%, color-mix(in oklab, var(--violet-hi) 80%, var(--violet)) 80%, var(--violet-hi));
    background-size: 170% 100%;
    background-position: 0% 50%;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      0 18px 36px -16px var(--accent-glow);
    opacity: 0;
    transform: translateY(26px) scale(0.96);
    filter: blur(6px);
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.75s var(--ease-spring),
      filter 0.45s var(--ease-out),
      background-position 0.9s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }
  .plan.is-on .plan-btn,
  .plan:focus-within .plan-btn {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }
  .plan .plan-btn:hover {
    background-position: 100% 50%;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      0 26px 46px -16px var(--accent-glow);
  }
  .plan .plan-btn:active {
    transform: scale(0.97);
  }
  .plan-btn .btn-icon {
    background: rgba(255, 255, 255, 0.16);
  }
  /* Sheen: one band of light crosses the button as it arrives, and again on hover. */
  .plan-btn::after {
    content: '';
    position: absolute;
    inset: -20% auto -20% 0;
    width: 40%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.32) 50%, transparent);
    transform: translateX(-140%) skewX(-18deg);
    pointer-events: none;
  }
  .plan-btn {
    overflow: hidden;
    isolation: isolate;
  }
  .plan.is-on .plan-btn::after,
  .plan-btn:hover::after {
    transform: translateX(300%) skewX(-18deg);
    transition: transform 1.1s var(--ease-out) 0.18s;
  }

  /* Touch screens, the stacked one-column layout and reduced motion: every choice stays in view. */
  @media (hover: none), (max-width: 960px), (prefers-reduced-motion: reduce) {
    .plan .plan-btn {
      opacity: 1;
      transform: none;
      filter: none;
      pointer-events: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plan-body,
    .plan-light::before,
    .plan-light::after,
    .plan .plan-btn,
    .plan-btn::after {
      transition: none;
    }
    .plan.is-on .plan-body {
      transform: none;
    }
  }
  .plan-includes {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-2);
    margin-top: 6px;
  }
  .plan-features {
    display: grid;
    gap: 12px;
  }
  .plan-features li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 10px;
    align-items: start;
    font-size: 0.97rem;
    line-height: 1.45;
  }
  .plan-features :global(.icon) {
    margin-top: 2px;
    font-size: 1.1rem;
    color: var(--ink-2);
  }
  .plan--featured .plan-features :global(.icon) {
    color: var(--accent-text);
  }
  .pricing-note {
    margin-top: 40px;
    text-align: center;
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 960px) {
    .plans {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
    .plan--featured {
      transform: none;
    }
  }
</style>
