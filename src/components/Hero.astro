---
import Phone from './Phone.astro';
import Icon from './Icon.astro';
import { SIGNUP_URL, TRIAL_DAYS } from '../config';
import catalog from '../assets/shots/shell-catalog.png';
import orders from '../assets/shots/orders-list.png';
import analytics from '../assets/shots/analytics.png';

// Two typeset lines, split into words at build time so the intro runs in CSS alone
// (the headline paints on the first frame instead of waiting for the script).
const lines = [
  ['Магазин', 'у', 'Telegram,'],
  ['готовий', 'за вечір'],
];

// Order numbers continue the demo data on the orders screenshot (#51 to #54).
const notifications = [
  { n: 55, sum: '1 500 грн', what: 'Футболка, M', where: 'Київ, відділення №12', pay: 'Оплачено через LiqPay' },
  { n: 56, sum: '2 750 грн', what: 'Джинси, 30', where: 'Львів, поштомат №5207', pay: 'Оплачено через plata by mono' },
  { n: 57, sum: '4 199 грн', what: '3 товари', where: 'Одеса, відділення №41', pay: 'Накладений платіж' },
];
let w = 0;
---
<section class="hero" id="top" data-hero>
  <div class="container hero-top">
    <p class="hero-tag hero-in" style="--d:0ms">
      <Icon name="telegram-logo" /> Для тих, хто продає в Instagram і Telegram
    </p>
    <h1 class="display hero-title">
      {lines.map((line, li) => (
        <span class:list={['hl', `hl-${li + 1}`]} data-hl={li + 1}>
          {line.map((word, i) => (
            <Fragment>
              <span class="hero-word"><span style={`--w:${w++}`}>{word}</span></span>{i < line.length - 1 && ' '}
            </Fragment>
          ))}
        </span>
      ))}
    </h1>
    <div class="hero-row">
      <p class="lead hero-lead hero-in hero-in--soft" style="--d:300ms">
        Покупці замовляють і платять, не виходячи з Telegram. Ви отримуєте оплачене замовлення і створюєте ТТН однією кнопкою.
      </p>
      <div class="hero-actions hero-in" style="--d:420ms">
        <div class="hero-ctas">
          <a class="btn btn-primary" href={SIGNUP_URL} target="_blank" rel="noopener" data-magnetic>
            Створити магазин
            <span class="btn-icon"><Icon name="paper-plane-tilt" /></span>
          </a>
          <a class="btn btn-ghost" href="#demo">Спробувати демо</a>
        </div>
        <p class="hero-note"><Icon name="seal-check" /> {TRIAL_DAYS} днів безкоштовно, картка не потрібна</p>
      </div>
    </div>
  </div>

  <div class="hero-stage" data-hero-stage>
    <div class="hero-tilt" data-tilt>
      <div class="hero-slot hero-slot--left">
        <Phone src={orders} alt="Список замовлень з фільтрами в адмінці Cartium" width={300} sizes="(max-width: 560px) 200px, 300px" eager class="hero-phone" />
      </div>
      <div class="hero-slot hero-slot--right">
        <Phone src={analytics} alt="Аналітика магазину: виторг, замовлення, середній чек" width={300} sizes="(max-width: 560px) 200px, 300px" eager class="hero-phone" />
      </div>
      <div class="hero-slot hero-slot--center">
        <Phone src={catalog} alt="Вітрина магазину в Telegram з категоріями та кошиком" width={330} sizes="(max-width: 560px) 236px, 330px" priority class="hero-phone" />
      </div>
    </div>

    <div class="notif" data-notif aria-hidden="true">
      <div class="notif-head">
        <span class="notif-avatar"><Icon name="storefront" /></span>
        <span class="notif-from">urbanstyle_bot</span>
        <span class="notif-time">щойно</span>
      </div>
      <div class="notif-body">
        {notifications.map((o, i) => (
          <div class:list={['notif-item', { 'is-active': i === 0 }]} data-notif-item>
            <p class="notif-title">📦 Нове замовлення #{o.n}</p>
            <p class="notif-line"><strong>{o.sum}</strong> · {o.what}</p>
            <p class="notif-line">{o.where}</p>
            <p class="notif-pay"><Icon name="check-circle-fill" /> {o.pay}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(44px, 6vw, 84px));
    overflow: clip;
  }
  .hero-top {
    display: grid;
    gap: clamp(20px, 2.4vw, 32px);
    position: relative;
    z-index: 2;
  }
  .hero-tag {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px 7px 10px;
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink-2);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .hero-tag :global(.icon) {
    font-size: 1.1rem;
  }

  /* The headline is the hero: two set lines, the second offset like a magazine cover. */
  .hero-title {
    display: grid;
    font-size: clamp(2.7rem, 1rem + 6.6vw, 7.1rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.96;
  }
  .hl {
    display: block;
    white-space: nowrap;
    will-change: transform;
  }
  .hl-2 {
    padding-left: clamp(0px, 14vw, 230px);
  }
  .hero-word {
    display: inline-block;
    overflow: clip;
    vertical-align: top;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hero-word > span {
    display: inline-block;
  }

  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 24px 48px;
    padding-top: clamp(20px, 2.4vw, 32px);
    border-top: 1px solid var(--line-strong);
    margin-top: clamp(8px, 1.4vw, 20px);
  }
  .hero-lead {
    max-width: 30em;
    color: var(--ink-2);
  }
  .hero-actions {
    display: grid;
    gap: 14px;
    justify-items: end;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .hero-note :global(.icon) {
    font-size: 1.1rem;
    color: var(--ink);
  }

  /* Phones rise from below the fold; main.ts lifts them further as you scroll. */
  .hero-stage {
    position: relative;
    height: clamp(560px, 56vw, 760px);
    margin-top: clamp(28px, 4vw, 56px);
    perspective: 1600px;
  }
  .hero-stage::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 8%;
    width: min(1100px, 92vw);
    aspect-ratio: 2 / 1;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(10, 10, 11, 0.1), transparent 70%);
    filter: blur(20px);
  }
  .hero-tilt {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .hero-slot {
    position: absolute;
    top: 0;
    left: 50%;
    width: 300px;
  }
  .hero-slot--center {
    width: 330px;
    transform: translateX(-50%);
    z-index: 3;
  }
  .hero-slot--left {
    transform: translate(-128%, 70px) rotate(-8deg) scale(0.9);
    z-index: 1;
  }
  .hero-slot--right {
    transform: translate(28%, 70px) rotate(8deg) scale(0.9);
    z-index: 2;
  }

  .notif {
    position: absolute;
    z-index: 5;
    left: calc(50% + 120px);
    top: 70px;
    width: 272px;
    padding: 14px 16px 16px;
    border-radius: 22px;
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-lift);
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .notif-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .notif-avatar {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
  }
  .notif-from {
    font-weight: 600;
    color: var(--ink);
  }
  .notif-time {
    margin-left: auto;
  }
  .notif-body {
    display: grid;
  }
  .notif-item {
    grid-area: 1 / 1;
    display: grid;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
  }
  .notif-item.is-active {
    opacity: 1;
    visibility: visible;
  }
  .notif-title {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 2px;
  }
  .notif-line {
    color: var(--ink-2);
  }
  .notif-line strong {
    font-weight: 600;
  }
  .notif-pay {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    justify-self: start;
    padding: 4px 10px 4px 8px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.8rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-word > span {
      animation: hero-rise 1.1s var(--ease-out) backwards;
      animation-delay: calc(var(--w) * 70ms + 60ms);
    }
    .hero-in {
      animation: hero-fade 1s var(--ease-out) backwards;
      animation-delay: var(--d, 0ms);
    }
    .hero-in--soft {
      animation-name: hero-slide;
    }
    .hero-slot :global(.hero-phone) {
      animation: hero-phone 1.6s var(--ease-out) backwards;
    }
    /* The centre phone is the mobile LCP image: it slides in but is never transparent. */
    .hero-slot--center :global(.hero-phone) {
      animation-name: hero-phone-rise;
    }
    .hero-slot--left :global(.hero-phone) {
      animation-delay: 280ms;
    }
    .hero-slot--right :global(.hero-phone) {
      animation-delay: 380ms;
    }
    .notif {
      animation: hero-notif 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s backwards;
    }
  }
  @keyframes hero-rise {
    from {
      transform: translateY(108%);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  /* The lead is the mobile LCP element: it moves in but is never transparent. */
  @keyframes hero-slide {
    from {
      transform: translateY(14px);
    }
  }
  @keyframes hero-phone {
    from {
      opacity: 0;
      transform: translateY(160px);
    }
  }
  @keyframes hero-phone-rise {
    from {
      transform: translateY(120px);
    }
  }
  @keyframes hero-notif {
    from {
      opacity: 0;
      transform: translateY(-16px) scale(0.94);
    }
  }

  @media (max-width: 900px) {
    .hl {
      white-space: normal;
    }
    .hl-2 {
      padding-left: 0;
    }
    .hero-row {
      grid-template-columns: 1fr;
    }
    .hero-actions {
      justify-items: start;
    }
    .notif {
      left: auto;
      right: 4%;
      top: auto;
      bottom: 10%;
    }
  }
  @media (max-width: 560px) {
    .hero-stage {
      height: 470px;
    }
    .hero-slot--center {
      width: 236px;
    }
    .hero-slot--left,
    .hero-slot--right {
      width: 200px;
    }
    .hero-slot--left {
      transform: translate(-112%, 50px) rotate(-8deg) scale(0.88);
    }
    .hero-slot--right {
      transform: translate(12%, 50px) rotate(8deg) scale(0.88);
    }
    .notif {
      right: 50%;
      translate: 50% 0;
      bottom: 4%;
      width: min(300px, calc(100vw - 48px));
    }
  }
</style>
