  .coach-ring.is-on,
  .coach.is-on {
    opacity: 1;
  }
  @keyframes coach-pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 2px var(--ink),
        0 0 0 6px color-mix(in srgb, var(--ink) 14%, transparent);
    }
