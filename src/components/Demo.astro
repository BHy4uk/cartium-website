      0 0 0 6px color-mix(in srgb, var(--ink) 14%, transparent);
    animation: coach-pulse 1.6s var(--ease-out) infinite;
  }
  .coach {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 260px;
    padding: 9px 14px 9px 10px;
    border-radius: 14px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    box-shadow: 0 12px 30px -10px rgba(10, 10, 11, 0.5);
  }
  .coach::after {
    content: '';
    position: absolute;
    left: var(--arrow-x, 24px);
    width: 12px;
    height: 12px;
    background: inherit;
    transform: translateX(-50%) rotate(45deg);
    border-radius: 2px;
  }
  .coach[data-side='above']::after {
    bottom: -5px;
  }
  .coach[data-side='below']::after {
    top: -5px;
  }
  .coach[data-side='edge'] {
    pointer-events: auto;
