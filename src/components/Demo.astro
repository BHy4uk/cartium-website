---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import teePhoto from '../assets/products/tee.png';
import pantsPhoto from '../assets/products/pants.png';
import shortsPhoto from '../assets/products/shorts.png';
import ringPhoto from '../assets/products/ring.png';
import drapeBanner from '../assets/banners/drape.jpg';
import rainBanner from '../assets/banners/rain.jpg';
import archBanner from '../assets/banners/arch.jpg';
import { SIGNUP_URL } from '../config';

// A working miniature of a Cartium storefront. Every control below maps to a real
// setting of Керування → Налаштування → Вигляд (webapp/shared/theme.js,
// application/store_templates.py); prices and the Нова пошта address follow the docs' demo data.
// The demo shop is Cartium's own sample store: its products, prices, categories and campaign
// photos (src/assets/products, src/assets/banners), laid out the way the real templates do it.
const photo = async (src: ImageMetadata, width?: number) => (await getImage({ src, width, format: 'webp', quality: 82 })).src;
const products = [
  { id: 'tee', name: 'Футболка', cat: 'tees', price: 1300, img: await photo(teePhoto), tone: '#2a2a2a', sizes: ['S', 'M', 'L', 'XL'], soldOut: ['XL'] },
  { id: 'pants', name: 'Штани', cat: 'clothes', price: 2600, old: 3500, img: await photo(pantsPhoto), tone: '#2a2a2a', sizes: ['28', '30', '32', '34'], soldOut: ['28'] },
  { id: 'shorts', name: 'Шорти', cat: 'clothes', price: 2400, img: await photo(shortsPhoto), tone: '#2a2a2a', sizes: ['S', 'M', 'L'], soldOut: [] },
  { id: 'ring', name: 'Кільце', cat: 'acc', price: 6500, img: await photo(ringPhoto), tone: '#2a2a2a', sizes: ['16', '17', '18', '19'], soldOut: ['16'] },
];
const byId = Object.fromEntries(products.map((p) => [p.id, p]));
const cats = [
  { id: 'all', label: 'Усі' },
  { id: 'tees', label: 'Футболки' },
  { id: 'clothes', label: 'Одяг' },
  { id: 'acc', label: 'Аксесуари' },
];
const banner = {
  drape: await photo(drapeBanner, 430),
  rain: await photo(rainBanner, 660),
  arch: await photo(archBanner, 430),
};
// Four of the ten real templates (store_templates.py): structure, plan and description are the
// product's own; the media slots get the sample store's campaign photos.
const templates = [
  { id: 'classic', name: 'Classic', plan: 'Basic', text: 'Класичний магазин з банером і категоріями.' },
  { id: 'minimal', name: 'Minimal', plan: 'Pro', text: 'Мінімалістичний стиль. Акцент на товари.' },
  { id: 'full_screen', name: 'Full Screen', plan: 'Business', text: 'Великий банер на весь екран. Ідеально для бренду.' },
  { id: 'editorial', name: 'Editorial', plan: 'Business', text: 'Стиль онлайн-журналу. Історії, фото, колекції.' },
];
// "auto" is the storefront default: near-black on light, near-white on dark (DEFAULT_ACCENT).
const accents = [
  { id: 'auto', label: 'Як у темі', value: 'auto', paint: 'linear-gradient(135deg, #1d1d1f 50%, #f5f5f7 50%)' },
  { id: 'graphite', label: 'Графіт', value: '#3a3a3f', paint: '#3a3a3f' },
  { id: 'silver', label: 'Сріблястий', value: '#8e8e96', paint: '#8e8e96' },
];
// Вигляд → Фон каталогу: a few light and dark backdrops (the shop's dark theme rides on the dark ones).
const backgrounds = [
  { id: 'mist', label: 'Світло-сірий', bg: '#f4f4f6', card: '#ffffff' },
  { id: 'white', label: 'Білий', bg: '#ffffff', card: '#f1f1f3' },
  { id: 'sand', label: 'Пісочний', bg: '#f3eee6', card: '#fffdf9' },
  { id: 'graphite', label: 'Графіт', bg: '#161618', card: '#222225' },
  { id: 'black', label: 'Чорний', bg: '#000000', card: '#121212' },
];
// FONT_STACKS keys and labels from the appearance editor.
const fonts = [
  { id: 'modern', label: 'Modern', face: 'Inter' },
  { id: 'neutral', label: 'Helvetica', face: 'Helvetica Neue' },
  { id: 'premium', label: 'IBM Plex Sans', face: 'IBM Plex Sans' },
  { id: 'fashion', label: 'Fashion', face: 'Space Grotesk' },
  { id: 'system', label: 'System', face: 'рідний шрифт' },
];
const fmt = (n: number) => `${n.toLocaleString('uk-UA').replace(/[  ]/g, ' ')} грн`;
---
<section class="section studio" id="demo" aria-labelledby="demo-title" data-demo>
  <script type="application/json" data-demo-products set:html={JSON.stringify(products)} />
  <script type="application/json" data-demo-backgrounds set:html={JSON.stringify(backgrounds)} />
  <div class="container">
    <div class="studio-head">
      <div class="studio-intro">
        <h2 id="demo-title" class="display h2">Зберіть магазин. Потім купіть у&nbsp;ньому.</h2>
        <p class="lead" data-fill>
          Оформіть вітрину, купіть як покупець і прийміть замовлення як власник. Кожен перемикач тут є у&nbsp;справжньому Cartium.
        </p>
      </div>

      <!-- The stopwatch: runs from the first click to the TTN, so the visitor times the whole sale
           themself. The real launch time (35 min) is the sum of the steps in Launch.astro. -->
      <div class="studio-clock" data-clock data-state="idle">
        <p class="studio-live"><span class="live-dot" aria-hidden="true"></span> Інтерактивне демо: тут усе натискається</p>
        <div class="clock-row">
          <span class="clock-icon" aria-hidden="true"><Icon name="timer" /></span>
          <span class="clock-time" data-clock-time role="timer" aria-label="Час у демо">0:00</span>
          <ol class="clock-steps" aria-hidden="true">
            <li data-clock-step="style"></li>
            <li data-clock-step="buy"></li>
            <li data-clock-step="ship"></li>
          </ol>
        </div>
        <p class="clock-note" data-clock-note>Рахує час від першого кліку до ТТН.</p>
      </div>
    </div>

    <div class="studio-grid glow-host">
      <div class="aura glow" data-glow-for=".dphone" aria-hidden="true"></div>
      <!-- 1. Controls -->
      <div class="studio-col studio-col--panel">
      <header class="step-head" data-step-flag="style">
        <span class="sf-dot"><span class="sf-num">1</span><Icon name="check" /></span>
        <span class="step-copy">
          <span class="step-title">Оформіть вітрину</span>
          <span class="step-hint" data-step-hint data-idle="Як у редакторі «Вигляд» вашого магазину">Як у редакторі «Вигляд» вашого магазину</span>
        </span>
      </header>
      <!-- The editor's side panel, as Вигляд shows it on a wide screen: tap an element of the shop
           (or a dock button) and its settings open here. On phones the same sheet moves into the
           phone and slides up over the shop, as in the app. -->
      <div class="studio-panel ed" data-ed>
        <p class="ed-tip">
          <span class="ed-tip-icon" aria-hidden="true"><Icon name="hand-tap" /></span>
          <span class="ed-tip-wide">Натисніть на будь-який елемент вітрини, і тут відкриються його налаштування.</span>
          <span class="ed-tip-narrow">Натисніть на будь-який елемент вітрини нижче, і його налаштування відкриються знизу.</span>
        </p>

        <div class="ed-sheet" data-ed-sheet role="region" aria-label="Налаштування елемента">
          <span class="ed-grip" aria-hidden="true"></span>
          <button type="button" class="ed-done" data-ed-done>Готово</button>

          <section class="ed-sec" data-sec="header" aria-labelledby="ed-h-header">
            <header class="ed-sec-head">
              <span class="ed-sec-icon" aria-hidden="true"><Icon name="browser" /></span>
              <span><span class="ed-sec-title" id="ed-h-header">Шапка</span><span class="ed-sec-sub">Назва, логотип і кнопки</span></span>
            </header>
            <div class="sp-identity">
              <label class="sp-logo" for="demo-logo" title="Завантажити логотип">
                <input id="demo-logo" type="file" accept="image/*" data-demo-logo-input />
                <span class="sp-logo-img" data-demo-logo-preview hidden></span>
                <span class="sp-logo-empty"><Icon name="upload-simple" /></span>
                <span class="sr-only">Логотип магазину</span>
              </label>
              <div class="sp-name">
                <label for="demo-name" class="sp-label">Назва магазину</label>
                <input id="demo-name" class="sp-input" type="text" maxlength="22" value="Cartium" autocomplete="off" spellcheck="false" data-demo-input />
              </div>
            </div>
            <div class="sp-row">
              <span class="sp-label">Кнопки в шапці</span>
              <div class="ed-switches">
                <button type="button" class="switch" role="switch" aria-checked="true" data-ed-toggle="search">
                  <span>Пошук</span><span class="switch-track"><span class="switch-thumb"></span></span>
                </button>
                <button type="button" class="switch" role="switch" aria-checked="true" data-ed-toggle="filters">
                  <span>Фільтри та сортування</span><span class="switch-track"><span class="switch-thumb"></span></span>
                </button>
              </div>
            </div>
          </section>

          <section class="ed-sec" data-sec="template" aria-labelledby="ed-h-template" hidden>
            <header class="ed-sec-head">
              <span class="ed-sec-icon" aria-hidden="true"><Icon name="layout" /></span>
              <span><span class="ed-sec-title" id="ed-h-template">Шаблон магазину</span><span class="ed-sec-sub">Банер і порядок блоків</span></span>
            </header>
            <div class="tpl-grid" role="radiogroup" aria-label="Шаблон магазину">
              {templates.map((t, i) => (
                <button type="button" class="tpl" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-set="template" data-value={t.id} title={t.text}>
                  <span class:list={['tpl-thumb', `tpl-thumb--${t.id}`]} aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                  <span class="tpl-name">{t.name} <span class="tpl-plan">{t.plan}</span></span>
                  <span class="tpl-text">{t.text}</span>
                </button>
              ))}
            </div>
            <p class="sp-note">У Cartium 10 шаблонів: на Basic доступний 1, на Pro 3, на Business усі.</p>
          </section>

          <section class="ed-sec" data-sec="cards" aria-labelledby="ed-h-cards" hidden>
            <header class="ed-sec-head">
              <span class="ed-sec-icon" aria-hidden="true"><Icon name="squares-four" /></span>
              <span><span class="ed-sec-title" id="ed-h-cards">Картки товарів</span><span class="ed-sec-sub">Однаково для всіх товарів</span></span>
            </header>
            <div class="sp-row">
              <span class="sp-label">Картки</span>
              <div class="seg" role="radiogroup" aria-label="Стиль карток">
                <button type="button" role="radio" aria-checked="true" data-set="cards" data-value="flat">Плаский</button>
                <button type="button" role="radio" aria-checked="false" data-set="cards" data-value="soft">М'який</button>
                <button type="button" role="radio" aria-checked="false" data-set="cards" data-value="outline">Контурний</button>
              </div>
            </div>
            <div class="sp-row">
              <span class="sp-label">Скруглення</span>
              <div class="seg" role="radiogroup" aria-label="Скруглення">
                <button type="button" role="radio" aria-checked="true" data-set="radius" data-value="rounded">М'яке</button>
                <button type="button" role="radio" aria-checked="false" data-set="radius" data-value="medium">Помірне</button>
                <button type="button" role="radio" aria-checked="false" data-set="radius" data-value="sharp">Мінімальне</button>
              </div>
            </div>
          </section>

          <section class="ed-sec" data-sec="colors" aria-labelledby="ed-h-colors" hidden>
            <header class="ed-sec-head">
              <span class="ed-sec-icon" aria-hidden="true"><Icon name="palette" /></span>
              <span><span class="ed-sec-title" id="ed-h-colors">Кольори й кнопки</span><span class="ed-sec-sub">Акцент для кнопок і цін</span></span>
            </header>
            <div class="sp-row">
              <span class="sp-label">Акцент кнопок</span>
              <div class="sp-swatches" role="radiogroup" aria-label="Акцент кнопок">
                {accents.map((a, i) => (
                  <button type="button" class="sw" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-set="accent" data-value={a.value} title={a.label}>
                    <span style={`background:${a.paint}`}></span><span class="sr-only">{a.label}</span>
                  </button>
                ))}
                <label class="sw sw--custom" title="Свій колір">
                  <input type="color" value="#1d1d1f" data-demo-color />
                  <span class="sw-custom-ring"></span>
                  <span class="sr-only">Свій колір</span>
                </label>
              </div>
            </div>
            <div class="sp-row">
              <span class="sp-label">Кнопки</span>
              <div class="seg" role="radiogroup" aria-label="Стиль кнопок">
                <button type="button" role="radio" aria-checked="true" data-set="buttons" data-value="filled">Суцільні</button>
                <button type="button" role="radio" aria-checked="false" data-set="buttons" data-value="outline">Контурні</button>
              </div>
            </div>
          </section>

          <section class="ed-sec" data-sec="bg" aria-labelledby="ed-h-bg" hidden>
            <header class="ed-sec-head">
              <span class="ed-sec-icon" aria-hidden="true"><Icon name="image" /></span>
              <span><span class="ed-sec-title" id="ed-h-bg">Фон каталогу</span><span class="ed-sec-sub">Світлий чи темний магазин</span></span>
            </header>
            <div class="bg-list" role="radiogroup" aria-label="Фон каталогу">
              {backgrounds.map((b, i) => (
                <button type="button" class="bg-opt" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-set="bg" data-value={b.id}>
                  <span class="bg-chip" style={`background:${b.bg}`} aria-hidden="true"><i style={`background:${b.card}`}></i><i style={`background:${b.card}`}></i></span>
                  <span class="bg-name">{b.label}</span>
                </button>
              ))}
            </div>
          </section>

          <section class="ed-sec" data-sec="font" aria-labelledby="ed-h-font" hidden>
            <header class="ed-sec-head">
              <span class="ed-sec-icon" aria-hidden="true"><Icon name="text-aa" /></span>
              <span><span class="ed-sec-title" id="ed-h-font">Шрифт</span><span class="ed-sec-sub">Для назви, цін і кнопок</span></span>
            </header>
            <div class="font-list" role="radiogroup" aria-label="Шрифт">
              {fonts.map((f, i) => (
                <button type="button" class="font-opt" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-set="font" data-value={f.id}>
                  <span class="font-sample" data-font-sample={f.id}>Ag</span>
                  <span class="font-meta"><strong>{f.label}</strong><span>{f.face}</span></span>
                </button>
              ))}
            </div>
          </section>

          <section class="ed-sec" data-sec="promo" aria-labelledby="ed-h-promo" hidden>
            <header class="ed-sec-head">
              <span class="ed-sec-icon" aria-hidden="true"><Icon name="megaphone-simple" /></span>
              <span><span class="ed-sec-title" id="ed-h-promo">Верхній рядок</span><span class="ed-sec-sub">Біжучий рядок з оголошенням</span></span>
            </header>
            <button type="button" class="switch" role="switch" aria-checked="true" data-demo-promo-toggle>
              <span>Показувати рядок</span><span class="switch-track"><span class="switch-thumb"></span></span>
            </button>
            <div class="sp-field">
              <label for="demo-promo" class="sp-label">Текст оголошення</label>
              <input id="demo-promo" class="sp-input" type="text" maxlength="60" value="SS2026 // NEW SEASON // OUT NOW" data-demo-promo-input />
            </div>
            <div class="sp-row">
              <span class="sp-label">Рух</span>
              <div class="seg" role="radiogroup" aria-label="Рух рядка">
                <button type="button" role="radio" aria-checked="false" data-set="promo" data-value="center">По центру</button>
                <button type="button" role="radio" aria-checked="true" data-set="promo" data-value="continuous">Безперервно</button>
                <button type="button" role="radio" aria-checked="false" data-set="promo" data-value="static">Статично</button>
              </div>
            </div>
          </section>
        </div>

        <div class="ed-foot">
          <button type="button" class="sp-btn sp-btn--icon" data-demo-shuffle title="Перемішати"><Icon name="shuffle" /><span class="sr-only">Перемішати</span></button>
          <button type="button" class="sp-btn sp-btn--icon" data-demo-reset title="Скинути"><Icon name="arrow-counter-clockwise" /><span class="sr-only">Скинути</span></button>
          <button type="button" class="ed-save" data-ed-save>
            <span class="ed-save-on"><Icon name="check" /> Зберегти</span>
            <span class="ed-save-off"><Icon name="pencil-simple" /> Редагувати</span>
          </button>
        </div>
      </div>
      </div>

      <!-- 2. Buyer -->
      <div class="studio-col studio-col--phone">
        <header class="step-head" data-step-flag="buy">
          <span class="sf-dot"><span class="sf-num">2</span><Icon name="check" /></span>
          <span class="step-copy">
            <span class="step-title">Купіть як покупець</span>
            <span class="step-hint" data-step-hint data-idle="Так вітрину бачать у Telegram">Так вітрину бачать у Telegram</span>
          </span>
        </header>
        <div class="dphone iphone" data-dphone data-screen="catalog" data-template="classic" data-promo="continuous" data-editing="true">
          <span class="iphone-key iphone-key--action" aria-hidden="true"></span>
          <span class="iphone-key iphone-key--up" aria-hidden="true"></span>
          <span class="iphone-key iphone-key--down" aria-hidden="true"></span>
          <span class="iphone-key iphone-key--side" aria-hidden="true"></span>
          <div class="iphone-body"><div class="iphone-glass">
          <div class="dphone-screen iphone-screen" data-ds>
            <div class="iphone-status" aria-hidden="true">
              <span>9:41</span>
              <span class="iphone-island"></span>
              <span class="iphone-icons">
                <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
                <svg viewBox="0 0 16 12"><path d="M8 2.4c2.3 0 4.4.9 6 2.4l1.3-1.4A10.6 10.6 0 0 0 8 .4 10.6 10.6 0 0 0 .7 3.4L2 4.8a8.6 8.6 0 0 1 6-2.4Zm0 3.8c1.3 0 2.5.5 3.4 1.3l1.3-1.4A7 7 0 0 0 8 4.2a7 7 0 0 0-4.7 1.9l1.3 1.4c.9-.8 2.1-1.3 3.4-1.3Zm0 3.8c.4 0 .8.2 1.1.4L8 11.6 6.9 10.4c.3-.2.7-.4 1.1-.4Z" /></svg>
                <svg viewBox="0 0 27 12"><rect x="0.5" y="0.5" width="23" height="11" rx="3.2" fill="none" stroke="currentColor" stroke-opacity="0.4" /><rect x="2" y="2" width="20" height="8" rx="2" /><path d="M25 4v4c.8-.3 1.4-1.1 1.4-2s-.6-1.7-1.4-2Z" fill-opacity="0.45" /></svg>
              </span>
            </div>
            <!-- Editor chrome (Редагування): the compact head, the selection frame and the dock. -->
            <div class="ed-bar" data-ed-bar>
              <button type="button" class="ed-close" data-ed-mode="view" aria-label="Закрити редактор"><Icon name="x" /></button>
              <span class="ed-modes" role="group" aria-label="Режим">
                <button type="button" aria-pressed="true" data-ed-mode="edit">Редагування</button>
                <button type="button" aria-pressed="false" data-ed-mode="view">Перегляд</button>
              </span>
            </div>
            <span class="ed-sel" data-ed-sel aria-hidden="true"><span class="ed-sel-tag" data-ed-sel-tag></span></span>
            <div class="ds-promo" data-ds-promo data-ed-target="promo">
              <div class="ds-promo-track" data-ds-promo-track><span data-ds-promo-text>SS2026 // NEW SEASON // OUT NOW</span></div>
            </div>

            <!-- Catalog -->
            <div class="dscreen dscreen--catalog" data-screen-id="catalog">
              <!-- Header: its own bar (Editorial, Carousel), an image banner (Classic), or controls
                   riding on the opening picture (Minimal, Full Screen, Split Hero), as in the shop. -->
              <header class="ds-head" data-ed-target="header">
                <span class="ds-brand">
                  <span class="ds-logo" data-ds-logo hidden></span>
                  <span class="ds-shop" data-demo-name>Cartium</span>
                </span>
                <span class="ds-icons" aria-hidden="true">
                  <span data-hb="search"><Icon name="magnifying-glass" /></span>
                  <span data-hb="filters"><Icon name="sliders-horizontal" /></span>
                </span>
              </header>
              <div class="tb tb-headbar" data-tb="classic" data-ed-target="header">
                <img class="tb-media" src={banner.rain} alt="" loading="lazy" decoding="async" />
                <span class="ds-brand">
                  <span class="ds-logo" data-ds-logo hidden></span>
                  <span class="ds-shop" data-demo-name>Cartium</span>
                </span>
                <span class="tb-ctrls" aria-hidden="true"><span data-hb="search"><Icon name="magnifying-glass" /></span><span data-hb="filters"><Icon name="sliders-horizontal" /></span></span>
              </div>

              <!-- Minimal: a short banner -->
              <div class="tb tb-hero tb-hero--short" data-tb="minimal" data-ed-target="template">
                <img class="tb-media" src={banner.rain} alt="" loading="lazy" decoding="async" />
                <span class="tb-ctrls" aria-hidden="true" data-ed-target="header"><span data-hb="search"><Icon name="magnifying-glass" /></span><span data-hb="filters"><Icon name="sliders-horizontal" /></span></span>
                <span class="tb-copy">
                  <span class="tb-title"><span data-demo-name>Cartium</span> SS'27</span>
                  <button type="button" class="tb-cta" data-scroll-grid>Order now</button>
                </span>
              </div>
              <!-- Full Screen: the opening screen -->
              <div class="tb tb-hero tb-hero--screen" data-tb="full_screen" data-ed-target="template">
                <img class="tb-media" src={banner.drape} alt="" loading="lazy" decoding="async" />
                <span class="tb-ctrls" aria-hidden="true" data-ed-target="header"><span data-hb="search"><Icon name="magnifying-glass" /></span><span data-hb="filters"><Icon name="sliders-horizontal" /></span></span>
                <span class="tb-copy">
                  <span class="tb-sub">Нова колекція</span>
                  <span class="tb-title"><span data-demo-name>Cartium</span> SS'27</span>
                  <button type="button" class="tb-cta" data-scroll-grid>Order now</button>
                </span>
              </div>
              <!-- Editorial: a tall story, then a pair -->
              <div class="tb tb-editorial" data-tb="editorial" data-ed-target="template">
                <button type="button" class="tb-hero tb-hero--story" data-scroll-grid>
                  <img class="tb-media" src={banner.arch} alt="" loading="lazy" decoding="async" />
                  <span class="tb-copy"><span class="tb-sub">Історія колекції</span><span class="tb-title">Архітектура форми</span></span>
                </button>
                <button type="button" class="tb-hero tb-hero--pick" data-cat-jump="clothes">
                  <img class="tb-media" src={byId.pants.img} alt="" loading="lazy" decoding="async" />
                  <span class="tb-copy"><span class="tb-title tb-title--sm">Одяг</span></span>
                </button>
                <button type="button" class="tb-hero tb-hero--pick" data-cat-jump="acc">
                  <img class="tb-media" src={byId.ring.img} alt="" loading="lazy" decoding="async" />
                  <span class="tb-copy"><span class="tb-title tb-title--sm">Прикраси</span></span>
                </button>
              </div>
              <div class="ds-chips" role="group" aria-label="Категорії">
                {cats.map((c, i) => (
