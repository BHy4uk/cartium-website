---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import teePhoto from '../assets/products/tee.png';
import pantsPhoto from '../assets/products/pants.png';
import shortsPhoto from '../assets/products/shorts.png';
import ringPhoto from '../assets/products/ring.png';
import { SIGNUP_URL } from '../config';

// A working miniature of a Cartium storefront. Every control below maps to a real
// setting of Керування → Налаштування → Вигляд (webapp/shared/theme.js,
// application/store_templates.py); prices and the Нова пошта address follow the docs' demo data.
// The demo products are Cartium's own sample photos (src/assets/products); names and prices
// follow the docs' demo shop, so they match the screenshots elsewhere on the page.
const photo = async (src: ImageMetadata) => (await getImage({ src, format: 'webp', quality: 82 })).src;
const products = [
  { id: 'tee', name: 'Футболка', cat: 'tees', price: 1500, img: await photo(teePhoto), tone: '#2a2a2a', sizes: ['S', 'M', 'L', 'XL'], soldOut: ['XL'] },
  { id: 'jeans', name: 'Джинси', cat: 'jeans', price: 2750, old: 3450, img: await photo(pantsPhoto), tone: '#2a2a2a', sizes: ['29', '30', '32', '34'], soldOut: ['29'] },
  { id: 'shorts', name: 'Шорти', cat: 'shorts', price: 2200, img: await photo(shortsPhoto), tone: '#2a2a2a', sizes: ['S', 'M', 'L', 'XL'], soldOut: [] },
  { id: 'ring', name: 'Кільце', cat: 'acc', price: 1800, img: await photo(ringPhoto), tone: '#2a2a2a', sizes: ['16', '17', '18', '19'], soldOut: ['16'] },
];
const byId = Object.fromEntries(products.map((p) => [p.id, p]));
const cats = [
  { id: 'all', label: 'Усі' },
  { id: 'tees', label: 'Футболки', img: byId.tee.img },
  { id: 'jeans', label: 'Джинси', img: byId.jeans.img },
  { id: 'shorts', label: 'Шорти', img: byId.shorts.img },
  { id: 'acc', label: 'Аксесуари', img: byId.ring.img },
];
// Four of the ten real templates; descriptions are the product's own.
const templates = [
  { id: 'classic', name: 'Classic', text: 'Класичний магазин з категоріями і сіткою товарів.' },
  { id: 'minimal', name: 'Minimal', text: 'Мінімалістичний стиль. Акцент на товари.' },
  { id: 'grid_focus', name: 'Grid Focus', text: 'Акцент на каталозі. Чиста сітка товарів.' },
  { id: 'editorial', name: 'Editorial', text: 'Стиль онлайн-журналу. Історії, фото, колекції.' },
];
// "auto" is the storefront default: near-black on light, near-white on dark (DEFAULT_ACCENT).
const accents = [
  { id: 'auto', label: 'Як у темі', value: 'auto', paint: 'linear-gradient(135deg, #1d1d1f 50%, #f5f5f7 50%)' },
  { id: 'graphite', label: 'Графіт', value: '#3a3a3f', paint: '#3a3a3f' },
  { id: 'silver', label: 'Сріблястий', value: '#8e8e96', paint: '#8e8e96' },
];
// FONT_STACKS keys and labels from the appearance editor.
const fonts = [
  { id: 'modern', label: 'Modern', face: 'Inter' },
  { id: 'neutral', label: 'Helvetica', face: 'Helvetica Neue' },
  { id: 'premium', label: 'IBM Plex Sans', face: 'IBM Plex Sans' },
  { id: 'fashion', label: 'Fashion', face: 'Space Grotesk' },
  { id: 'system', label: 'System', face: 'рідний шрифт' },
];
const fmt = (n: number) => `${n.toLocaleString('uk-UA').replace(/[  ]/g, ' ')} грн`;
---
<section class="section studio" id="demo" aria-labelledby="demo-title" data-demo>
  <script type="application/json" data-demo-products set:html={JSON.stringify(products)} />
  <div class="container">
    <div class="studio-head">
      <p class="studio-live"><span class="live-dot" aria-hidden="true"></span><Icon name="cursor-click" /> Інтерактивне демо: тут усе натискається</p>
      <h2 id="demo-title" class="display h2">Зберіть свою вітрину. Потім купіть у ній щось.</h2>
      <p class="lead">
        Кожен перемикач тут повторює розділ «Вигляд» у вашому магазині. Налаштуйте, оформіть замовлення як покупець і подивіться, що в цю секунду отримуєте ви.
      </p>
    </div>

    <ol class="studio-steps" aria-label="Кроки демо">
      <li data-step-flag="style" class="is-current"><span class="sf-dot"><span class="sf-num">1</span><Icon name="check" /></span> Оформіть вітрину</li>
      <li data-step-flag="buy"><span class="sf-dot"><span class="sf-num">2</span><Icon name="check" /></span> Купіть як покупець</li>
      <li data-step-flag="ship"><span class="sf-dot"><span class="sf-num">3</span><Icon name="check" /></span> Прийміть замовлення і створіть ТТН</li>
    </ol>

    <div class="studio-grid">
      <!-- Controls -->
      <div class="studio-panel">
        <div class="sp-identity">
          <label class="sp-logo" for="demo-logo" title="Завантажити логотип">
            <input id="demo-logo" type="file" accept="image/*" data-demo-logo-input />
            <span class="sp-logo-img" data-demo-logo-preview hidden></span>
            <span class="sp-logo-empty"><Icon name="upload-simple" /></span>
            <span class="sr-only">Логотип магазину</span>
          </label>
          <div class="sp-name">
            <label for="demo-name" class="sp-label">Назва магазину</label>
            <input id="demo-name" class="sp-input" type="text" maxlength="22" value="Urban Style" autocomplete="off" spellcheck="false" data-demo-input />
          </div>
        </div>

        <div class="sp-tabs" role="tablist" aria-label="Налаштування вигляду">
          <button type="button" role="tab" id="tab-tpl" aria-controls="pane-tpl" aria-selected="true" data-tab="tpl"><Icon name="layout" /> Шаблон</button>
          <button type="button" role="tab" id="tab-style" aria-controls="pane-style" aria-selected="false" tabindex="-1" data-tab="style"><Icon name="paint-brush-broad" /> Стиль</button>
          <button type="button" role="tab" id="tab-font" aria-controls="pane-font" aria-selected="false" tabindex="-1" data-tab="font"><Icon name="text-aa" /> Шрифт</button>
          <button type="button" role="tab" id="tab-promo" aria-controls="pane-promo" aria-selected="false" tabindex="-1" data-tab="promo"><Icon name="megaphone-simple" /> Рядок</button>
        </div>

        <div class="sp-pane" role="tabpanel" id="pane-tpl" aria-labelledby="tab-tpl" data-pane="tpl">
          <div class="tpl-grid" role="radiogroup" aria-label="Шаблон магазину">
            {templates.map((t, i) => (
              <button type="button" class="tpl" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-set="template" data-value={t.id}>
                <span class:list={['tpl-thumb', `tpl-thumb--${t.id}`]} aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                <span class="tpl-name">{t.name}</span>
                <span class="tpl-text">{t.text}</span>
              </button>
            ))}
          </div>
          <p class="sp-note">Ще шість: Full Screen, Split Hero, Video Hero, Carousel, Masonry, Sidebar. На Basic доступний 1 шаблон, на Pro 3, на Business 10.</p>
        </div>

        <div class="sp-pane" role="tabpanel" id="pane-style" aria-labelledby="tab-style" data-pane="style" hidden>
          <div class="sp-row">
            <span class="sp-label">Тема</span>
            <div class="seg" role="radiogroup" aria-label="Тема">
              <button type="button" role="radio" aria-checked="true" data-set="mode" data-value="light">Світла</button>
              <button type="button" role="radio" aria-checked="false" data-set="mode" data-value="dark">Темна</button>
            </div>
          </div>
          <div class="sp-row">
            <span class="sp-label">Акцент кнопок</span>
            <div class="sp-swatches" role="radiogroup" aria-label="Акцент кнопок">
              {accents.map((a, i) => (
                <button type="button" class="sw" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-set="accent" data-value={a.value} title={a.label}>
                  <span style={`background:${a.paint}`}></span><span class="sr-only">{a.label}</span>
                </button>
              ))}
              <label class="sw sw--custom" title="Свій колір">
                <input type="color" value="#1d1d1f" data-demo-color />
                <span class="sw-custom-ring"></span>
                <span class="sr-only">Свій колір</span>
              </label>
            </div>
          </div>
          <div class="sp-row">
            <span class="sp-label">Кнопки</span>
            <div class="seg" role="radiogroup" aria-label="Стиль кнопок">
              <button type="button" role="radio" aria-checked="true" data-set="buttons" data-value="filled">Суцільні</button>
              <button type="button" role="radio" aria-checked="false" data-set="buttons" data-value="outline">Контурні</button>
            </div>
          </div>
          <div class="sp-row">
            <span class="sp-label">Скруглення</span>
            <div class="seg" role="radiogroup" aria-label="Скруглення">
              <button type="button" role="radio" aria-checked="true" data-set="radius" data-value="rounded">М'яке</button>
              <button type="button" role="radio" aria-checked="false" data-set="radius" data-value="medium">Помірне</button>
              <button type="button" role="radio" aria-checked="false" data-set="radius" data-value="sharp">Мінімальне</button>
            </div>
          </div>
          <div class="sp-row">
            <span class="sp-label">Картки</span>
            <div class="seg" role="radiogroup" aria-label="Стиль карток">
              <button type="button" role="radio" aria-checked="true" data-set="cards" data-value="flat">Плаский</button>
              <button type="button" role="radio" aria-checked="false" data-set="cards" data-value="soft">М'який</button>
              <button type="button" role="radio" aria-checked="false" data-set="cards" data-value="outline">Контурний</button>
            </div>
          </div>
        </div>

        <div class="sp-pane" role="tabpanel" id="pane-font" aria-labelledby="tab-font" data-pane="font" hidden>
          <div class="font-list" role="radiogroup" aria-label="Шрифт">
            {fonts.map((f, i) => (
              <button type="button" class="font-opt" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-set="font" data-value={f.id}>
                <span class="font-sample" data-font-sample={f.id}>Ag</span>
                <span class="font-meta"><strong>{f.label}</strong><span>{f.face}</span></span>
              </button>
            ))}
          </div>
        </div>

        <div class="sp-pane" role="tabpanel" id="pane-promo" aria-labelledby="tab-promo" data-pane="promo" hidden>
          <button type="button" class="switch" role="switch" aria-checked="true" data-demo-promo-toggle>
            <span class="switch-track"><span class="switch-thumb"></span></span>
            <span>Верхній рядок</span>
          </button>
          <div class="sp-field">
            <label for="demo-promo" class="sp-label">Текст оголошення</label>
            <input id="demo-promo" class="sp-input" type="text" maxlength="60" value="Безкоштовна доставка від 2 000 грн" data-demo-promo-input />
          </div>
          <div class="sp-row">
            <span class="sp-label">Рух</span>
            <div class="seg" role="radiogroup" aria-label="Рух рядка">
              <button type="button" role="radio" aria-checked="false" data-set="promo" data-value="center">По центру</button>
              <button type="button" role="radio" aria-checked="true" data-set="promo" data-value="continuous">Безперервно</button>
              <button type="button" role="radio" aria-checked="false" data-set="promo" data-value="static">Статично</button>
            </div>
          </div>
        </div>

        <div class="sp-foot">
          <button type="button" class="sp-btn" data-demo-shuffle><Icon name="shuffle" /> Перемішати</button>
          <button type="button" class="sp-btn" data-demo-reset><Icon name="arrow-counter-clockwise" /> Скинути</button>
        </div>
      </div>

      <!-- Buyer -->
      <div class="studio-col">
        <p class="studio-who">Покупець бачить</p>
        <div class="dphone iphone" data-dphone data-screen="catalog" data-template="classic" data-promo="continuous">
          <span class="iphone-key iphone-key--action" aria-hidden="true"></span>
          <span class="iphone-key iphone-key--up" aria-hidden="true"></span>
          <span class="iphone-key iphone-key--down" aria-hidden="true"></span>
          <span class="iphone-key iphone-key--side" aria-hidden="true"></span>
          <div class="iphone-body"><div class="iphone-glass">
          <div class="dphone-screen iphone-screen" data-ds>
            <div class="iphone-status" aria-hidden="true">
              <span>9:41</span>
              <span class="iphone-island"></span>
              <span class="iphone-icons">
                <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
                <svg viewBox="0 0 16 12"><path d="M8 2.4c2.3 0 4.4.9 6 2.4l1.3-1.4A10.6 10.6 0 0 0 8 .4 10.6 10.6 0 0 0 .7 3.4L2 4.8a8.6 8.6 0 0 1 6-2.4Zm0 3.8c1.3 0 2.5.5 3.4 1.3l1.3-1.4A7 7 0 0 0 8 4.2a7 7 0 0 0-4.7 1.9l1.3 1.4c.9-.8 2.1-1.3 3.4-1.3Zm0 3.8c.4 0 .8.2 1.1.4L8 11.6 6.9 10.4c.3-.2.7-.4 1.1-.4Z" /></svg>
                <svg viewBox="0 0 27 12"><rect x="0.5" y="0.5" width="23" height="11" rx="3.2" fill="none" stroke="currentColor" stroke-opacity="0.4" /><rect x="2" y="2" width="20" height="8" rx="2" /><path d="M25 4v4c.8-.3 1.4-1.1 1.4-2s-.6-1.7-1.4-2Z" fill-opacity="0.45" /></svg>
              </span>
            </div>
            <div class="ds-promo" data-ds-promo>
              <div class="ds-promo-track" data-ds-promo-track><span data-ds-promo-text>Безкоштовна доставка від 2 000 грн</span></div>
            </div>

            <!-- Catalog -->
            <div class="dscreen dscreen--catalog" data-screen-id="catalog">
              <header class="ds-head">
                <span class="ds-brand">
                  <span class="ds-logo" data-ds-logo hidden></span>
                  <span class="ds-shop" data-demo-name>Urban Style</span>
                </span>
                <span class="ds-icons" aria-hidden="true">
                  <span><Icon name="magnifying-glass" /></span>
                  <span><Icon name="sliders-horizontal" /></span>
                </span>
              </header>

              <!-- Template blocks -->
              <div class="tb tb-hero" data-tb="minimal">
                <p class="tb-hero-k">Нова колекція</p>
                <p class="tb-hero-t" data-demo-name>Urban Style</p>
                <button type="button" class="ds-btn ds-btn--sm" data-scroll-grid>До каталогу</button>
              </div>
              <div class="tb tb-tiles" data-tb="grid_focus">
                {cats.filter((c) => c.img).map((c) => (
                  <button type="button" class="tb-tile" data-cat-jump={c.id}><span class="tb-tile-img"><img src={c.img} alt="" loading="lazy" decoding="async" /></span><span>{c.label}</span></button>
                ))}
              </div>
              <button type="button" class="tb tb-lead" data-tb="editorial" data-open="jeans">
                <span class="tb-lead-img"><img src={byId.jeans.img} alt="" loading="lazy" decoding="async" /></span>
                <span class="tb-lead-k">Історія колекції</span>
                <span class="tb-lead-t">Чорний денім, який з часом стає тільки кращим</span>
                <span class="tb-lead-p">{fmt(byId.jeans.price)}</span>
              </button>

              <div class="ds-chips" role="group" aria-label="Категорії">
                {cats.map((c, i) => (
                  <button type="button" class="ds-chip" aria-pressed={i === 0 ? 'true' : 'false'} data-cat={c.id}>{c.label}</button>
                ))}
              </div>
              <ul class="ds-grid" data-ds-grid>
                {products.map((p) => (
                  <li class="ds-card" data-product-card data-cat={p.cat}>
                    <button type="button" class="ds-card-hit" data-open={p.id}>
                      <span class="ds-img" style={`--tone:${p.tone}`}><img src={p.img} alt="" loading="lazy" decoding="async" /></span>
                      <span class="ds-name">{p.name}</span>
                      <span class="ds-price">
                        {fmt(p.price)}
                        {p.old && <s>{fmt(p.old)}</s>}
                      </span>
                    </button>
                    <button type="button" class="ds-add" data-open={p.id} aria-label={`Обрати розмір: ${p.name}`}><Icon name="plus" /></button>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Cart -->
            <div class="dscreen dscreen--cart" data-screen-id="cart">
              <header class="ds-head"><span class="ds-title">Кошик</span></header>
              <ul class="ds-lines" data-cart-lines></ul>
              <div class="ds-empty" data-cart-empty>
                <Icon name="shopping-bag" />
                <p>Кошик порожній</p>
                <button type="button" class="ds-btn ds-btn--ghost" data-go="catalog">До каталогу</button>
              </div>
              <div class="ds-sticky" data-cart-footer>
                <p class="ds-total"><span>Разом</span><strong data-cart-total>0 грн</strong></p>
                <button type="button" class="ds-btn" data-go="checkout">Оформити замовлення</button>
              </div>
            </div>

            <!-- Checkout -->
            <div class="dscreen dscreen--checkout" data-screen-id="checkout">
              <header class="ds-head">
                <button type="button" class="ds-back" data-go="cart" aria-label="Назад до кошика"><Icon name="caret-left" /></button>
                <span class="ds-title">Оформлення</span>
              </header>
              <div class="ds-block">
                <p class="ds-block-title"><Icon name="truck" /> Нова пошта</p>
                <p>Київ, відділення №12</p>
                <p class="ds-muted">Олена Мельник, 097 ••• •• 67</p>
              </div>
              <div class="ds-pay" role="radiogroup" aria-label="Спосіб оплати">
                <button type="button" class="ds-pay-opt" role="radio" aria-checked="true" data-pay="liqpay">
                  <span class="ds-pay-name">Оплатити онлайн через LiqPay</span>
                  <span class="ds-pay-sub">Картка, Apple Pay, Google Pay</span>
                </button>
                <button type="button" class="ds-pay-opt" role="radio" aria-checked="false" data-pay="mono">
                  <span class="ds-pay-name">Оплатити онлайн через Monobank</span>
                  <span class="ds-pay-sub">plata by mono</span>
                </button>
                <button type="button" class="ds-pay-opt" role="radio" aria-checked="false" data-pay="cod">
                  <span class="ds-pay-name">Накладений платіж</span>
                  <span class="ds-pay-sub">Оплата при отриманні</span>
                </button>
              </div>
              <div class="ds-sticky">
                <button type="button" class="ds-btn" data-pay-submit><Icon name="lock-simple" /> <span data-pay-label>Оплатити</span></button>
              </div>
            </div>

            <!-- Processing and done -->
            <div class="dscreen dscreen--done" data-screen-id="done">
              <div class="ds-done" data-done>
                <span class="ds-spinner" aria-hidden="true"><Icon name="spinner-gap" /></span>
                <span class="ds-check" aria-hidden="true"><Icon name="check-circle-fill" /></span>
                <p class="ds-done-title" data-done-title>Оплата…</p>
                <p class="ds-muted" data-done-sub></p>
                <button type="button" class="ds-btn ds-btn--ghost" data-go="catalog" data-done-back>Повернутися в каталог</button>
                <button type="button" class="ds-btn ds-to-owner" data-to-owner>Що отримали ви <Icon name="caret-down" /></button>
              </div>
            </div>

            <!-- Product sheet -->
            <div class="ds-sheet" data-sheet aria-hidden="true">
              <div class="ds-sheet-scrim" data-sheet-close></div>
              <div class="ds-sheet-body" role="dialog" aria-label="Товар">
                <span class="ds-sheet-grip" aria-hidden="true"></span>
                <span class="ds-img ds-img--lg" data-sheet-img></span>
                <p class="ds-sheet-name" data-sheet-name></p>
                <p class="ds-price ds-price--lg" data-sheet-price></p>
                <p class="ds-muted">Розмір</p>
                <div class="ds-sizes" role="radiogroup" aria-label="Розмір" data-sheet-sizes></div>
                <button type="button" class="ds-btn" data-sheet-add>Додати в кошик</button>
              </div>
            </div>

            <nav class="ds-tabs" aria-label="Розділи магазину">
              <button type="button" class="ds-tab" data-go="catalog" data-tab-id="catalog"><Icon name="house" /><span>Каталог</span></button>
              <button type="button" class="ds-tab" data-go="cart" data-tab-id="cart">
                <span class="ds-tab-icon"><Icon name="shopping-bag" /><span class="ds-badge" data-cart-badge hidden>0</span></span>
                <span>Кошик</span>
              </button>
              <button type="button" class="ds-tab" disabled><Icon name="receipt" /><span>Замовлення</span></button>
            </nav>

            <p class="ds-toast" data-toast role="status" aria-live="polite"></p>
            <span class="iphone-home" aria-hidden="true"></span>
          </div>
          </div></div>
        </div>
      </div>

      <!-- Owner -->
      <div class="studio-col">
        <p class="studio-who">Ви отримуєте</p>
        <div class="dchat" id="demo-owner" data-dchat>
          <header class="dchat-head">
            <span class="dchat-avatar" data-demo-initial aria-hidden="true">U</span>
            <div>
              <p class="dchat-name" data-demo-bot>urbanstyle_bot</p>
              <p class="dchat-sub">бот вашого магазину</p>
            </div>
          </header>
          <dl class="dchat-stats">
            <div><dt>Замовлень сьогодні</dt><dd data-stat-orders>0</dd></div>
            <div><dt>Виторг</dt><dd data-stat-revenue>0 грн</dd></div>
          </dl>
          <div class="dchat-log" role="log" aria-live="polite" data-chat-log>
            <div class="bmsg">
