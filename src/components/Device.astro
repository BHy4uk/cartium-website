---
// The iPhone frame (styles in global.css, "iPhone frame"). Content goes in the slot, under the
// status bar and above the home indicator.
interface Props {
  width?: number | string;
  class?: string;
  [key: string]: unknown;
}
const { width = 320, class: className, ...rest } = Astro.props;
const w = typeof width === 'number' ? `${width}px` : width;
---
<div class:list={['iphone', className]} style={`--device-w:${w}`} {...rest}>
  <span class="iphone-key iphone-key--action" aria-hidden="true"></span>
  <span class="iphone-key iphone-key--up" aria-hidden="true"></span>
  <span class="iphone-key iphone-key--down" aria-hidden="true"></span>
  <span class="iphone-key iphone-key--side" aria-hidden="true"></span>
  <div class="iphone-body">
    <div class="iphone-glass">
      <div class="iphone-screen">
        <div class="iphone-status" aria-hidden="true">
          <span>9:41</span>
          <span class="iphone-island"></span>
          <span class="iphone-icons">
            <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
            <svg viewBox="0 0 16 12"><path d="M8 2.4c2.3 0 4.4.9 6 2.4l1.3-1.4A10.6 10.6 0 0 0 8 .4 10.6 10.6 0 0 0 .7 3.4L2 4.8a8.6 8.6 0 0 1 6-2.4Zm0 3.8c1.3 0 2.5.5 3.4 1.3l1.3-1.4A7 7 0 0 0 8 4.2a7 7 0 0 0-4.7 1.9l1.3 1.4c.9-.8 2.1-1.3 3.4-1.3Zm0 3.8c.4 0 .8.2 1.1.4L8 11.6 6.9 10.4c.3-.2.7-.4 1.1-.4Z" /></svg>
            <svg viewBox="0 0 27 12"><rect x="0.5" y="0.5" width="23" height="11" rx="3.2" fill="none" stroke="currentColor" stroke-opacity="0.4" /><rect x="2" y="2" width="20" height="8" rx="2" /><path d="M25 4v4c.8-.3 1.4-1.1 1.4-2s-.6-1.7-1.4-2Z" fill-opacity="0.45" /></svg>
          </span>
        </div>
        <div class="iphone-content"><slot /></div>
        <span class="iphone-home" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>
