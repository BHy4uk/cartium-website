---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
// A real catalog product (the Cartium demo tee). Each operation shows a prepared result, so
// picking one visibly changes the photo; the preserve-mode ones keep the tee where it was.
import teeOriginal from '../assets/products/tee-ai/original.jpg';
import teeReplace from '../assets/products/tee-ai/replace_background.jpg';
import teeStudio from '../assets/products/tee-ai/studio.jpg';
import teeImprove from '../assets/products/tee-ai/improve.jpg';
import teeCatalog from '../assets/products/tee-ai/catalog_ready.jpg';

const webp = async (src: ImageMetadata, width: number) =>
  (await getImage({ src, format: 'webp', quality: 88, width })).src;

// Labels and hints are the product's own (application/ai_image_operations.py).
const operations = await Promise.all(
  [
    { id: 'replace_background', label: 'Замінити фон', hint: 'Товар без змін, новий фон', img: teeReplace, alt: 'футболка на бежевому фоні' },
    { id: 'studio', label: 'Студійне фото', hint: "Чистий фон і м'яке світло", img: teeStudio, alt: 'футболка в студійному світлі' },
    { id: 'improve', label: 'Покращити фото', hint: 'Світло, колір, різкість', img: teeImprove, alt: 'футболка з виправленим світлом і різкістю' },
    { id: 'catalog_ready', label: 'Для каталогу', hint: 'По центру, однакові відступи', img: teeCatalog, alt: 'футболка по центру на білому' },
  ].map(async (o) => ({ ...o, src: await webp(o.img, 900), thumb: await webp(o.img, 240) })),
);
const originalSrc = await webp(teeOriginal, 900);
---
<section class="section growth" id="growth" aria-labelledby="growth-title">
  <div class="container">
    <div class="section-head">
      <h2 id="growth-title" class="display h2">Коли продажі пішли, вмикайте інструменти росту</h2>
      <p class="lead">Усе вже вбудовано в магазин. Спробуйте тут.</p>
    </div>

    <!-- One focal tool, then four quiet ones: a big before/after the eye lands on first, and a calm
         row of cards that each say one thing with one picture. -->
    <article class="ai-stage glow-host" data-ai>
      <div class="aura glow" data-glow-for=".ai-compare" aria-hidden="true"></div>
      <div class="ai-copy">
        <p class="eyebrow ai-eyebrow"><Icon name="sparkle" /> AI-фото</p>
        <h3 class="ai-title">Фото для каталогу без фотографа</h3>
        <p class="ai-lead">Оберіть дію і потягніть повзунок. У товар фото потрапить, лише коли ви його приймете.</p>
        <div class="ops" role="radiogroup" aria-label="Що зробити з фото">
          {operations.map((o, i) => (
            <button type="button" class="op" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-ai-op={o.id} title={o.hint}>
              <span class="op-pic" aria-hidden="true"><img src={o.thumb} alt="" loading="lazy" decoding="async" /></span>
              <span class="op-label">{o.label}</span>
            </button>
          ))}
        </div>
        <div class="ai-actions">
          <button type="button" class="ai-accept" data-ai-accept><Icon name="check" /> Прийняти в товар</button>
          <span class="ai-status" data-ai-status role="status" aria-live="polite"></span>
        </div>
      </div>
      <div class="ai-compare" data-ai-compare style="--split:50%">
        <div class="ai-before">
          <img src={originalSrc} alt="Оригінальне фото футболки на темному тлі" width="900" height="1200" loading="lazy" decoding="async" />
        </div>
        <div class="ai-after" data-ai-after>
          {operations.map((o, i) => (
            <img src={o.src} alt={`AI-чернетка: ${o.alt}`} width="900" height="1200" loading="lazy" decoding="async" data-ai-img={o.id} class:list={{ 'is-on': i === 0 }} aria-hidden={i === 0 ? undefined : 'true'} />
          ))}
        </div>
        <span class="ai-tag" aria-hidden="true">Ваше фото</span>
        <span class="ai-tag ai-tag--after" aria-hidden="true"><Icon name="sparkle" /> AI-чернетка</span>
        <span class="ai-handle" aria-hidden="true"><Icon name="caret-left" /><Icon name="caret-right" /></span>
        <input class="ai-range" type="range" min="0" max="100" value="50" aria-label="Порівняти ваше фото й AI-чернетку" data-ai-range />
      </div>
    </article>

    <ul class="tools">
      <li class="tool">
        <div class="tool-pic tool-pic--remind" aria-hidden="true">
          <p class="remind-msg">
            <span class="remind-when"><Icon name="bell-ringing" /> Через 30 хвилин</span>
            Ви залишили в кошику Джинси, 30. Повернутися до оформлення?
          </p>
        </div>
        <h3 class="tool-title">Нагадає про кошик</h3>
        <p class="tool-text">Бот сам напише тим, хто не дооформив. Текст і час обираєте ви.</p>
      </li>
      <li class="tool">
        <div class="tool-pic tool-pic--import" aria-hidden="true">
          <span class="import-num">2 000</span>
          <span class="import-files"><Icon name="file-csv" /><Icon name="file-xls" /></span>
        </div>
        <h3 class="tool-title">Товари одним файлом</h3>
        <p class="tool-text">До 2 000 позицій з CSV або XLSX, з варіантами і фото. Скасувати можна 7 днів.</p>
      </li>
      <li class="tool">
        <div class="tool-pic tool-pic--pause">
          <button type="button" class="switch" role="switch" aria-checked="false" aria-label="Пауза оформлення" data-pause-switch>
            <span class="switch-track"><span class="switch-thumb"></span></span>
          </button>
          <span class="pause-state" data-pause-shop aria-hidden="true">
            <span class="pause-on"><Icon name="check" /> Оформлення відкрите</span>
            <span class="pause-off"><Icon name="pause" /> На паузі</span>
          </span>
        </div>
        <h3 class="tool-title">Пауза на відпустку</h3>
        <p class="tool-text">Каталог лишається відкритим, нові замовлення чекають на вас.</p>
      </li>
      <li class="tool">
        <div class="tool-pic tool-pic--coupons" aria-hidden="true">
          <span class="coupon"><b>VIP10</b><i>−10%</i></span>
          <span class="coupon"><b>COMEBACK</b><i>−150 грн</i></span>
          <span class="coupon"><b>FIRST</b><i>−5%</i></span>
        </div>
        <h3 class="tool-title">Кабінет з бонусами</h3>
        <p class="tool-text">Історія замовлень і промокоди для VIP, нових і тих, хто давно не купував.</p>
      </li>
    </ul>
  </div>
</section>

<style>
  /* ---------- The focal tool ---------- */
  .ai-stage {
    /* The photo column takes its width from the photo's height and proportions, set outright:
       Safari gives an auto track around an empty-looking box no width at all. */
    --ai-h: clamp(360px, 56svh, 480px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(var(--ai-h) * 3 / 4);
    align-items: center;
    gap: clamp(24px, 3.5vw, 56px);
    padding: clamp(20px, 3vw, 44px);
    border-radius: calc(var(--r-card) + 8px);
    background:
      radial-gradient(70% 90% at 85% 50%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%),
      linear-gradient(180deg, var(--surface-2), var(--surface));
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ai-copy {
    display: grid;
    justify-items: start;
    gap: 18px;
  }
  .ai-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
  }
  .ai-title {
    max-width: 16ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 1.3rem + 2.2vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .ai-lead {
    max-width: 40ch;
    color: var(--muted);
    font-size: 1.02rem;
  }
  /* Each action is a small preview of its own result, so the choice reads at a glance. */
  .ops {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    max-width: 480px;
  }
  .op {
    display: grid;
    gap: 8px;
    padding: 6px 6px 10px;
    border-radius: 18px;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 600;
    font-size: 0.86rem;
    text-align: center;
    transition:
      background-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      transform 0.4s var(--ease-spring);
  }
  .op:hover {
    background: var(--hover-soft);
  }
  .op:active {
    transform: scale(0.97);
  }
  .op[aria-checked='true'] {
    background: var(--surface-3);
    box-shadow:
      inset 0 0 0 1.5px var(--ink),
      var(--shadow-soft);
  }
  .op-pic {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 13px;
    background: #e6e6e6;
    overflow: hidden;
  }
  .op-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .op-label {
    min-height: 2.3em;
    display: grid;
    place-items: center;
    line-height: 1.15;
  }

  /* Before / after: the AI layer is clipped from the left at --split. Every result has the
     original's frame, so the tee lines up across the split. */
  .ai-compare {
    position: relative;
    align-self: center;
    aspect-ratio: 3 / 4;
    border-radius: 22px;
    overflow: hidden;
    background: #2a2a2a;
    box-shadow: inset 0 0 0 1px var(--line);
    isolation: isolate;
  }
  .ai-before,
  .ai-after {
    position: absolute;
    inset: 0;
  }
  .ai-before img,
  .ai-after img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-after {
    clip-path: inset(0 0 0 var(--split));
    overflow: hidden;
  }
  .ai-after img {
    opacity: 0;
    transition: opacity 0.55s var(--ease-out), filter 0.55s var(--ease-out), scale 0.7s var(--ease-out);
  }
  .ai-after img.is-on {
    opacity: 1;
  }
  /* "Generating": a light sweep over the AI side while the new result fades in. */
  .ai-after::after {
    content: '';
    position: absolute;
    z-index: 4;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.55) 50%, transparent 70%);
    background-size: 250% 100%;
    opacity: 0;
    pointer-events: none;
  }
  .ai-after.is-busy::after {
    opacity: 1;
    animation: ai-sweep 0.9s ease-in-out;
  }
  .ai-after.is-busy img.is-on {
    filter: blur(8px);
    scale: 1.03;
  }
  @keyframes ai-sweep {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -40% 0;
    }
  }

  .ai-tag {
    position: absolute;
    z-index: 5;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: rgba(10, 10, 11, 0.6);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
  }
  .ai-tag--after {
    left: auto;
    right: 12px;
    background: rgba(255, 255, 255, 0.88);
    color: #0a0a0b;
  }
  .ai-handle {
    position: absolute;
    z-index: 6;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    translate: -1px 0;
    background: #fff;
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  .ai-handle::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
  }
  .ai-handle :global(.icon) {
    position: absolute;
    top: 50%;
    z-index: 1;
    translate: 0 -50%;
    color: #0a0a0b;
    font-size: 15px;
  }
  .ai-handle :global(.icon:first-child) {
    right: 3px;
  }
  .ai-handle :global(.icon:last-child) {
    left: 3px;
  }
  .ai-range {
    position: absolute;
    z-index: 7;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .ai-compare:has(.ai-range:focus-visible) .ai-handle::before {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }

  .ai-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }
  .ai-accept {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.92rem;
    transition: transform 0.4s var(--ease-spring);
  }
  .ai-accept:active {
    transform: scale(0.97);
  }
  .ai-status {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  /* The photo keeps its proportions and takes its size from the screen height, so the stage
     never grows past a laptop screen. */
  .ai-stage .ai-compare {
    justify-self: center;
    width: 100%;
    height: auto;
    border-radius: 26px;
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 40px 80px -40px rgba(10, 10, 20, 0.45);
  }

  /* ---------- Four quiet tools ---------- */
  .tools {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }
  .tool {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 16px 16px 26px;
    border-radius: calc(var(--r-card) + 4px);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    box-shadow: inset 0 0 0 1px var(--line);
  }
  /* Hover: the card lifts 2px and its shadow softens out beneath it. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tool {
      transition:
        translate 0.5s var(--ease-spring),
        box-shadow 0.5s var(--ease-out);
    }
    .tool:hover {
      translate: 0 -2px;
      box-shadow:
        inset 0 0 0 1px var(--line),
        var(--shadow-soft);
    }
  }
  .tool-pic {
    position: relative;
    display: grid;
    place-items: center;
    height: 180px;
    margin-bottom: 14px;
    border-radius: 18px;
    background: var(--bg-raise);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .tool-title,
  .tool-text {
    padding-inline: 8px;
  }
  .tool-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  .tool-text {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.45;
  }

  /* Cart reminder: the message the bot sends. */
  .remind-msg {
    display: grid;
    gap: 4px;
    width: 84%;
    padding: 10px 12px;
    border-radius: 16px 16px 16px 5px;
    background: var(--surface-3);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
    font-size: 0.9rem;
    line-height: 1.35;
    transition: transform 0.6s var(--ease-spring);
  }
  .remind-when {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accent-text);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .tool:hover .remind-msg {
    transform: translateY(-4px) rotate(-1deg);
  }

  /* Import: the number is the picture. */
  .tool-pic--import {
    gap: 4px;
    align-content: center;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(255, 255, 255, 0.14), transparent 60%),
      var(--panel);
    color: var(--on-panel-muted);
  }
  .import-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 4.4rem;
    letter-spacing: -0.045em;
    line-height: 0.95;
    background: var(--chrome);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .import-files {
    display: flex;
    gap: 8px;
    font-size: 1.3rem;
  }

  /* Pause: the one switch on the row, and it works. */
  .tool-pic--pause {
    gap: 12px;
    align-content: center;
  }
  .switch {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  .switch-track {
    position: relative;
    width: 60px;
    height: 36px;
    border-radius: var(--r-pill);
    background: var(--line-strong);
    transition: background-color 0.3s var(--ease-out);
  }
  .switch-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 6px rgba(10, 10, 11, 0.25);
    transition: transform 0.5s var(--ease-spring);
  }
  .switch[aria-checked='true'] .switch-track {
    background: var(--accent);
  }
  .switch[aria-checked='true'] .switch-thumb {
    transform: translateX(24px);
  }
  .pause-state {
    display: grid;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .pause-on,
  .pause-off {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.5s var(--ease-spring);
  }
  .pause-on {
    background: var(--ok-soft);
    color: var(--ok);
  }
  .pause-off {
    background: var(--ink);
    color: var(--bg);
    opacity: 0;
    transform: translateY(6px);
  }
  .pause-state.is-paused .pause-on {
    opacity: 0;
    transform: translateY(-6px);
  }
  .pause-state.is-paused .pause-off {
    opacity: 1;
    transform: none;
  }

  /* Bonuses: three coupons fanned like cards in a hand. */
  .coupon {
    position: absolute;
    display: grid;
    gap: 2px;
    width: 48%;
    padding: 12px 14px;
    border-radius: 16px;
    background: var(--surface-3);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow-soft);
    font-size: 0.9rem;
    transition: transform 0.7s var(--ease-spring);
  }
  .coupon b {
    letter-spacing: 0.02em;
  }
  .coupon i {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--accent-text);
  }
  .coupon:nth-child(1) {
    transform: translate(-52%, 8%) rotate(-10deg);
  }
  .coupon:nth-child(2) {
    transform: translate(0, -4%) rotate(0deg);
    z-index: 1;
  }
  .coupon:nth-child(3) {
    transform: translate(52%, 8%) rotate(10deg);
  }
  .tool:hover .coupon:nth-child(1) {
    transform: translate(-60%, 4%) rotate(-14deg);
  }
  .tool:hover .coupon:nth-child(3) {
    transform: translate(60%, 4%) rotate(14deg);
  }

  @media (max-width: 1080px) {
    .ai-stage {
      --ai-h: clamp(320px, 60vw, 460px);
      grid-template-columns: minmax(0, 1fr);
    }
    .ai-stage .ai-compare {
      width: min(100%, calc(var(--ai-h) * 3 / 4));
    }
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .tools {
      grid-template-columns: minmax(0, 1fr);
    }
    .ops {
      gap: 6px;
    }
    .op {
      padding: 4px 4px 8px;
      border-radius: 14px;
      font-size: 0.72rem;
    }
    .op-pic {
      border-radius: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .remind-msg,
    .coupon,
    .switch-thumb {
      transition: none;
    }
  }
</style>
