---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import teePhoto from '../assets/products/tee.png';
import pantsPhoto from '../assets/products/pants.png';
import shortsPhoto from '../assets/products/shorts.png';
import ringPhoto from '../assets/products/ring-hd.png';
import bannerPhoto from '../assets/banners/arch.jpg';
import applePayLogo from '../assets/logos/apple-pay-light.svg?raw';

// One sale told twice and shown side by side, all at once: the whole Instagram-direct chat in the
// middle, the same sale through Cartium on the right. The numbers are read off this script
// (14 messages, 10:02 to 12:49 versus the buyer's 3 taps), not a statistic.
type Msg = { from: 'them' | 'me'; text?: string; time: string; kind?: 'shot' };
const chat: Msg[] = [
  { from: 'them', text: 'Добрий день! Скільки коштує футболка з фото?', time: '10:02' },
  { from: 'me', text: 'Добрий! 1 500 грн', time: '10:16' },
  { from: 'them', text: 'А розмір M є?', time: '10:17' },
  { from: 'me', text: 'Зараз гляну на складі 🙏', time: '10:31' },
  { from: 'me', text: 'Є, чорна і біла', time: '10:44' },
  { from: 'them', text: 'Чорну. Як оплатити?', time: '10:46' },
  { from: 'me', text: 'IBAN UA•• •••• •••• 4821, у призначенні вкажіть імʼя', time: '10:58' },
  { from: 'them', time: '11:20', kind: 'shot' },
  { from: 'me', text: 'Дякую, перевірю і напишу', time: '11:41' },
  { from: 'me', text: 'Оплату бачу ✅', time: '12:05' },
  { from: 'me', text: 'Напишіть ПІБ, телефон і відділення НП', time: '12:06' },
  { from: 'them', text: 'Олена Мельник, 097 ••• •• 67, Київ, №12', time: '12:31' },
  { from: 'me', text: 'Відправлю завтра, ТТН скину сюди', time: '12:40' },
  { from: 'me', text: 'ТТН 20451386942762', time: '12:49' },
];
// Instagram prints the time over the chat only after a long pause; three of them tell the story.
const stamps = new Set([0, 7, 11]);
// Like Instagram, the sender's bubbles shade from violet at the top of the chat to blue at the bottom.
const rows = chat.map((m, i) => ({
  ...m,
  stamp: stamps.has(i) ? (i === 0 ? `Сьогодні ${m.time}` : m.time) : '',
  groupEnd: chat[i + 1]?.from !== m.from || stamps.has(i + 1),
  tone: (i / (chat.length - 1)).toFixed(3),
}));
// Instagram's empty profile picture: no photo, just the grey silhouette.
const avatar = '<svg class="ig-ava" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="20" fill="#dbdbdb"/><circle cx="20" cy="15.6" r="7" fill="#fff"/><path d="M6.4 34.6C9 28.6 14 25.4 20 25.4s11 3.2 13.6 9.2A19.9 19.9 0 0 1 20 40a19.9 19.9 0 0 1-13.6-5.4z" fill="#fff"/></svg>';
// The buyer's three taps in Cartium.
const taps = ['Додати в кошик', 'Оформити замовлення', 'Сплатити Apple Pay'];
// The demo shop's catalogue, as in the Mini App screenshots.
const products = [
  { name: 'Футболка', price: '1 300 грн', img: teePhoto },
  { name: 'Штани', price: '2 600 грн', old: '3 500 грн', img: pantsPhoto },
  { name: 'Шорти', price: '1 100 грн', img: shortsPhoto },
  { name: 'Каблучка', price: '900 грн', img: ringPhoto, w: 496 },
];
const applePay = applePayLogo.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<section class="story stage" id="story" aria-labelledby="story-title" data-story data-stage>
  <div class="container">
    <div class="story-grid" data-story-grid>
      <div class="story-copy">
        <div class="story-head">
          <h2 id="story-title" class="display h2">Хочете побачити різницю?</h2>
          <p class="lead">Один і той самий продаж від першого повідомлення до&nbsp;ТТН.</p>
        </div>
        <p class="story-claim">
          <span class="claim-line" data-claim>У директі <b>{chat.length}</b>&nbsp;повідомлень.</span>
          <span class="claim-line claim-line--cartium" data-claim>У Cartium <b>{taps.length}</b>&nbsp;дії.</span>
        </p>
        <p class="story-note" data-claim>Від першого повідомлення до ТТН: 2&nbsp;год 47&nbsp;хв у&nbsp;директі і 3&nbsp;хв у&nbsp;Cartium.</p>
      </div>

      <!-- The direct chat, drawn like Instagram's dark Direct screen (no Instagram logo). -->
      <div class="story-col">
      <p class="story-label" data-story-label>
        <b>Обробка замовлень власноруч</b>
        <span class="story-chip">{chat.length} повідомлень · 2&nbsp;год 47&nbsp;хв</span>
      </p>
      <figure class="ig" data-ig aria-label={`Переписка в Instagram Direct, ${chat.length} повідомлень`}>
        <header class="ig-head" aria-hidden="true">
          <Icon name="caret-left" />
          <span class="ig-avatar" set:html={avatar} />
          <span class="ig-who">
            <span class="ig-name">unknown</span>
          </span>
          <span class="ig-tools"><Icon name="phone" /><Icon name="video-camera" /></span>
        </header>
        <ol class="ig-list">
          {rows.map((m) => (
            <>
              {m.stamp && <li class="ig-stamp" aria-hidden="true">{m.stamp}</li>}
              <li
                class:list={['ig-msg', `ig-msg--${m.from}`, m.groupEnd && 'is-end', m.kind && `ig-msg--${m.kind}`]}
                style={`--tone: ${m.tone}`}
                data-bubble
              >
                {m.from === 'them' && <span class="ig-face" set:html={avatar} />}
                {m.kind === 'shot' ? (
                  <span class="ig-shot" aria-label="Скріншот оплати">
                    <span class="ig-shot-lines" aria-hidden="true"><i></i><i></i><i></i></span>
                  </span>
                ) : (
                  <span class="ig-text">{m.text}</span>
                )}
              </li>
            </>
          ))}
        </ol>
        <div class="ig-compose" aria-hidden="true">
          <span class="ig-cam"><Icon name="camera" /></span>
          <span class="ig-field">Повідомлення…</span>
          <Icon name="microphone" />
          <Icon name="image" />
          <Icon name="sticker" />
        </div>
      </figure>
      </div>

      <!-- The same sale in the Cartium shop inside Telegram, played on a loop: add to cart,
           check out, pay with Apple Pay. Drawn after the real Mini App screens. -->
      <div class="story-col">
      <p class="story-label story-label--cartium" data-story-label>
        <b>Магазин, створений через Cartium</b>
        <span class="story-chip">{taps.length} дії · 3&nbsp;хв</span>
      </p>
      <div class="tg-wrap glow-host">
      <div class="aura glow story-aura" data-story-aura data-glow-for="[data-tg]" aria-hidden="true"></div>
      <figure class="tg" data-tg aria-label="Та сама покупка в магазині Cartium у Telegram: додати в кошик, оформити замовлення, сплатити Apple Pay">
        <div class="tg-status" aria-hidden="true">
          <time data-tg-time>10:02</time>
          <p class="tg-step" data-tg-step aria-hidden="true">
            {taps.map((t, i) => (
              <span class:list={['tg-step-text', i === 0 && 'is-on']}>
                <b>{i + 1}</b> {t}
              </span>
            ))}
            <span class="tg-step-text"><Icon name="check" /> Готово за {taps.length}&nbsp;дії</span>
          </p>
          <span class="tg-sys"><i></i><i></i><i></i><b></b></span>
        </div>
        <div class="tg-bar" aria-hidden="true">
          <span class="tg-pill"><Icon name="x" /> Close</span>
          <span class="tg-pill tg-pill--menu"><Icon name="caret-down" /><i class="tg-dots"></i></span>
        </div>
        <div class="tg-app" aria-hidden="true">
          <div class="tg-banner">
            <Image src={bannerPhoto} alt="" width={480} quality={70} class="tg-banner-img" />
            <span class="tg-shop">CARTIUM</span>
            <span class="tg-round"><Icon name="magnifying-glass" /></span>
            <span class="tg-round"><Icon name="sliders-horizontal" /></span>
          </div>
          <div class="tg-chips">
            <span class="is-on">Усі</span><span>Футболки</span><span>Лонгсліви</span><span>Одяг</span>
          </div>
          <ul class="tg-grid">
            {products.map((p, i) => (
              <li class="tg-card">
                <span class="tg-photo"><Image src={p.img} alt="" width={p.w ?? 248} quality={92} /></span>
                <span class="tg-name">{p.name}</span>
                <span class="tg-price">{p.price}{p.old && <s>{p.old}</s>}</span>
                <span class:list={['tg-add', i === 0 && 'is-target']} data-tg-add={i === 0 ? '' : undefined}>
                  <Icon name="plus" /><Icon name="check" />
                  {i === 0 && <span class="tg-tap" data-tg-tap></span>}
                </span>
              </li>
            ))}
          </ul>
          <nav class="tg-tabs">
            <span class="is-on"><Icon name="house-fill" />Каталог</span>
            <span><span class="tg-bag"><Icon name="shopping-bag" /><b class="tg-badge" data-tg-badge>1</b></span>Кошик</span>
            <span><Icon name="receipt" />Замовлення</span>
            <span><Icon name="user-circle" />Профіль</span>
          </nav>
        </div>
        <span class="tg-dim" data-tg-dim aria-hidden="true"></span>

        <div class="tg-sheet tg-cart" data-tg-cart aria-hidden="true">
          <span class="tg-grab"></span>
          <p class="tg-sheet-head"><b>Кошик</b> · 1 товар <span class="tg-x"><Icon name="x" /></span></p>
          <div class="tg-line">
            <span class="tg-thumb"><Image src={teePhoto} alt="" width={160} quality={90} /></span>
            <span class="tg-line-text"><b>Футболка</b><small>M · 1 300 грн за шт</small></span>
            <b class="tg-line-sum">1 300 грн</b>
          </div>
          <p class="tg-promo"><Icon name="tag" /> Промокод <Icon name="caret-down" /></p>
          <p class="tg-total"><b>Разом</b><b>1 300 грн</b></p>
          <span class="tg-cta" data-tg-checkout>Оформити замовлення<span class="tg-tap" data-tg-tap></span></span>
        </div>

        <div class="tg-sheet tg-pay" data-tg-pay aria-hidden="true">
          <p class="tg-pay-head"><span class="tg-pay-logo" set:html={applePay} /><span class="tg-x"><Icon name="x" /></span></p>
          <p class="tg-pay-row"><Icon name="credit-card" /><span><b>Картка</b><small>•••• ••••</small></span></p>
          <p class="tg-pay-row"><Icon name="truck" /><span><b>Нова пошта</b><small>Київ, відділення №12</small></span></p>
          <p class="tg-pay-sum"><small>Сплатити Cartium</small><b>1 300 грн</b></p>
          <p class="tg-pay-confirm">
            <span class="tg-pay-wait"><span class="tg-side"></span>Двічі натисніть бічну кнопку</span>
            <span class="tg-pay-ok"><Icon name="check-circle-fill" />Готово</span>
          </p>
        </div>
        <span class="tg-press" data-tg-press aria-hidden="true"></span>

        <div class="tg-done" data-tg-done aria-hidden="true">
          <span class="tg-done-mark"><Icon name="check" /></span>
          <b>Замовлення #55 оплачено</b>
          <small>Продавцю вже прийшло сповіщення в боті</small>
        </div>


      </figure>
      </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: clamp(72px, 9vw, 128px);
  }
  /* One screen: the claim on the left, the two versions of the sale beside it. */
  .story-grid {
    /* Both phones share one type size, scaled so the whole chat fits under the nav on a laptop. */
    --ig-fs: clamp(11px, calc((100svh - 400px) / 35), 14px);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.16fr) minmax(0, 0.94fr);
    align-items: stretch;
    gap: clamp(20px, 2.6vw, 40px);
  }
  /* Each phone carries its own caption, so it is clear at a glance which sale is which. */
  .story-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .story-col > .ig,
  .story-col > .tg-wrap {
    flex: 1;
  }
  .story-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    padding-inline: 6px;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.25rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .story-label b {
    font-weight: 600;
    color: var(--ink);
  }
  .story-chip {
    flex: none;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  .story-label--cartium b {
    color: var(--accent-text);
  }
  .story-label--cartium .story-chip {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-text) 30%, transparent);
    color: var(--accent-text);
  }
  .story-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(20px, 2.4vw, 32px);
  }
  .story-head {
    display: grid;
    gap: 16px;
  }
  .story-head .h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 1.2rem + 2.2vw, 3.2rem);
  }
  .story-head .lead {
    max-width: 34ch;
    font-size: 1.02rem;
  }
  .story-claim {
    display: grid;
    gap: 4px;
    padding-top: clamp(16px, 2vw, 24px);
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .claim-line {
    display: block;
    color: var(--ink-2);
  }
  .claim-line b {
    color: var(--ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .claim-line--cartium,
  .claim-line--cartium b {
    color: var(--accent-text);
  }
  .story-note {
    max-width: 32ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  /* ---------- Instagram Direct, dark ----------
     Its own palette, the way a screenshot of another app keeps its colours. --ig-fs scales the
     whole chat so all fourteen messages fit under the nav on a laptop. */
  .ig {
    --ig-sent-a: #a033ff;
    --ig-sent-b: #1a8cff;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    border-radius: 30px;
    background: #000;
    color: #f5f5f5;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: var(--ig-fs);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 40px 90px -50px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }
  .ig-head {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.8em 1.1em;
    border-bottom: 1px solid #262626;
  }
  .ig-head > :global(.icon) {
    font-size: 1.6em;
  }
  /* Instagram's empty profile picture: no photo, just the grey silhouette. */
  .ig-avatar,
  .ig-face {
    display: block;
    flex: none;
  }
  .ig-ava {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ig-avatar {
    width: 2.4em;
    height: 2.4em;
  }
  .ig-who {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }
  .ig-name {
    font-weight: 600;
  }
  .ig-tools {
    display: flex;
    gap: 1em;
    margin-left: auto;
    font-size: 1.55em;
  }
  .ig-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.5em 0.9em 0.4em;
  }
  .ig-stamp {
    align-self: center;
    margin: 0.35em 0 0.3em;
    color: #a8a8a8;
    font-size: 0.82em;
    font-weight: 500;
  }
  .ig-msg {
    display: flex;
    align-items: flex-end;
    gap: 0.5em;
    max-width: 88%;
    margin-top: 2px;
  }
  .ig-msg.is-end {
    margin-bottom: 6px;
  }
  .ig-msg--them {
    align-self: flex-start;
  }
  .ig-msg--me {
    align-self: flex-end;
  }
  .ig-text {
    padding: 0.42em 0.9em;
    border-radius: 1.25em;
    line-height: 1.3;
  }
  .ig-msg--them .ig-text {
    background: #262626;
  }
  .ig-msg--me .ig-text {
    background: color-mix(in oklab, var(--ig-sent-a), var(--ig-sent-b) calc(var(--tone) * 100%));
    color: #fff;
  }
  /* The tiny avatar sits beside the last bubble of each of her groups only. */
  .ig-face {
    width: 1.75em;
    height: 1.75em;
    visibility: hidden;
  }
  .ig-msg--them.is-end .ig-face {
    visibility: visible;
  }
  .ig-shot {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 3.2em;
    border-radius: 0.9em;
    background: #f2f2f2;
  }
  .ig-shot-lines {
    display: grid;
    gap: 0.28em;
    width: 60%;
  }
  .ig-shot-lines i {
    display: block;
    height: 0.28em;
    border-radius: 1px;
    background: #c9c9c9;
  }
  .ig-shot-lines i:nth-child(2) {
    width: 70%;
    background: #111;
  }
  .ig-compose {
    display: flex;
    align-items: center;
    gap: 0.75em;
    margin: 0.2em 0.8em 0.85em;
    padding: 0.35em 0.9em 0.35em 0.35em;
    border-radius: 2em;
    background: #262626;
    color: #f5f5f5;
  }
  .ig-compose > :global(.icon) {
    font-size: 1.35em;
  }
  .ig-cam {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: #3797f0;
    font-size: 1.05em;
  }
  .ig-field {
    flex: 1;
    color: #a8a8a8;
  }

  /* ---------- Cartium in Telegram ----------
     The Mini App in Telegram's dark theme, the same size as the Direct window. It keeps its own
     palette, the way a screenshot does; ultraviolet appears only where Cartium itself speaks. */
  .tg-wrap {
    position: relative;
    display: flex;
    min-width: 0;
  }
  /* The light comes up with the graphite stage (--stage-glow); main.ts centres it on the phone. */
  .story-aura {
    --aura-o: var(--stage-glow, 1);
  }
  .tg {
    --tg-ink: #fff;
    --tg-muted: #8e8e93;
    --tg-soft: #2c2c2e;
    --tg-panel: #1c1c1e;
    --tg-line: rgba(255, 255, 255, 0.1);
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    border-radius: 30px;
    background: #000;
    color: var(--tg-ink);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: var(--ig-fs);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 40px 90px -50px var(--accent-glow);
    overflow: hidden;
    isolation: isolate;
  }
  .tg-bar {
    display: flex;
    justify-content: space-between;
    padding: 0.2em 0.9em 0.6em;
  }
  .tg-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.45em 0.95em;
    border-radius: 2em;
    background: var(--tg-panel);
    color: #c7c7cc;
    font-weight: 600;
  }
  .tg-pill--menu {
    gap: 0.8em;
  }
  .tg-dots {
    width: 1.3em;
    height: 0.3em;
    background: radial-gradient(circle, currentColor 0.14em, transparent 0.16em) 0 0 / 0.45em 0.3em repeat-x;
  }
  .tg-app {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: #000;
  }
  .tg-banner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5em;
    height: 5em;
    padding: 0 0.9em;
    overflow: hidden;
    isolation: isolate;
    background: #222;
    color: #fff;
  }
  .tg-banner :global(.tg-banner-img) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.55);
  }
  .tg-shop {
    flex: 1;
    font-size: 1.7em;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .tg-round {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    border-radius: 0.8em;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 1.05em;
  }
  .tg-chips {
    display: flex;
    gap: 0.45em;
    padding: 0.7em 0.9em;
    white-space: nowrap;
    overflow: hidden;
  }
  .tg-chips span {
    padding: 0.45em 0.95em;
    border-radius: 2em;
    background: var(--tg-soft);
