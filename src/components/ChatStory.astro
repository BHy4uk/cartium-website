---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import teePhoto from '../assets/products/tee.png';

// One sale told twice and shown side by side, all at once: the whole Instagram-direct chat in the
// middle, the same sale through Cartium on the right. The numbers are read off this script
// (14 messages, 10:02 to 12:49 versus 3 actions, 10:02 to 10:05), not a statistic.
type Msg = { from: 'them' | 'me'; text?: string; time: string; kind?: 'shot' };
const chat: Msg[] = [
  { from: 'them', text: 'Добрий день! Скільки коштує футболка з фото?', time: '10:02' },
  { from: 'me', text: 'Добрий! 1 500 грн', time: '10:16' },
  { from: 'them', text: 'А розмір M є?', time: '10:17' },
  { from: 'me', text: 'Зараз гляну на складі 🙏', time: '10:31' },
  { from: 'me', text: 'Є, чорна і біла', time: '10:44' },
  { from: 'them', text: 'Чорну. Як оплатити?', time: '10:46' },
  { from: 'me', text: 'IBAN UA•• •••• •••• 4821, у призначенні вкажіть імʼя', time: '10:58' },
  { from: 'them', time: '11:20', kind: 'shot' },
  { from: 'me', text: 'Дякую, перевірю і напишу', time: '11:41' },
  { from: 'me', text: 'Оплату бачу ✅', time: '12:05' },
  { from: 'me', text: 'Напишіть ПІБ, телефон і відділення НП', time: '12:06' },
  { from: 'them', text: 'Олена Мельник, 097 ••• •• 67, Київ, №12', time: '12:31' },
  { from: 'me', text: 'Відправлю завтра, ТТН скину сюди', time: '12:40' },
  { from: 'me', text: 'ТТН 20451386942762', time: '12:49' },
];
// Instagram prints the time over the chat only after a long pause; three of them tell the story.
const stamps = new Set([0, 7, 11]);
// Like Instagram, the sender's bubbles shade from violet at the top of the chat to blue at the bottom.
const rows = chat.map((m, i) => ({
  ...m,
  stamp: stamps.has(i) ? (i === 0 ? `Сьогодні ${m.time}` : m.time) : '',
  groupEnd: chat[i + 1]?.from !== m.from || stamps.has(i + 1),
  tone: (i / (chat.length - 1)).toFixed(3),
}));
const actions = [
  { time: '10:02', icon: 'hand-pointing', who: 'Покупниця', text: 'Відкриває каталог і обирає футболку, чорну, M' },
  { time: '10:03', icon: 'credit-card', who: 'Покупниця', text: 'Платить через LiqPay, адреса Нової пошти вже у формі' },
  { time: '10:05', icon: 'truck', who: 'Ви', text: 'Натискаєте «Створити ТТН»' },
];
---
<section class="story stage" id="story" aria-labelledby="story-title" data-story data-stage>
  <div class="container">
    <div class="story-grid" data-story-grid data-snap>
      <div class="story-copy">
        <div class="story-head">
          <h2 id="story-title" class="display h2">Хочете побачити різницю?</h2>
          <p class="lead">Один і той самий продаж: у директі і в&nbsp;Cartium. Покупниця пише о 10:02, а ми рахуємо кожну дію, поки посилка не буде готова до відправки.</p>
        </div>
        <p class="story-claim">
          <span class="claim-line" data-claim>У директі <b>{chat.length}</b>&nbsp;повідомлень.</span>
          <span class="claim-line claim-line--cartium" data-claim>У Cartium <b>{actions.length}</b>&nbsp;дії.</span>
        </p>
        <p class="story-note" data-claim>Від першого повідомлення до ТТН: 2&nbsp;год 47&nbsp;хв у&nbsp;директі і 3&nbsp;хв у&nbsp;Cartium.</p>
      </div>

      <!-- The direct chat, drawn like Instagram's dark Direct screen (no Instagram logo). -->
      <figure class="ig" data-ig aria-label={`Переписка в Instagram Direct, ${chat.length} повідомлень`}>
        <header class="ig-head" aria-hidden="true">
          <Icon name="caret-left" />
          <span class="ig-avatar">О</span>
          <span class="ig-who">
            <span class="ig-name">olena.melnyk</span>
            <span class="ig-sub">Олена Мельник</span>
          </span>
          <span class="ig-tools"><Icon name="phone" /><Icon name="video-camera" /></span>
        </header>
        <ol class="ig-list">
          {rows.map((m) => (
            <>
              {m.stamp && <li class="ig-stamp" aria-hidden="true">{m.stamp}</li>}
              <li
                class:list={['ig-msg', `ig-msg--${m.from}`, m.groupEnd && 'is-end', m.kind && `ig-msg--${m.kind}`]}
                style={`--tone: ${m.tone}`}
                data-bubble
              >
                {m.from === 'them' && <span class="ig-face" aria-hidden="true">О</span>}
                {m.kind === 'shot' ? (
                  <span class="ig-shot" aria-label="Скріншот оплати">
                    <span class="ig-shot-lines" aria-hidden="true"><i></i><i></i><i></i></span>
                  </span>
                ) : (
                  <span class="ig-text">{m.text}</span>
                )}
              </li>
            </>
          ))}
        </ol>
        <div class="ig-compose" aria-hidden="true">
          <span class="ig-cam"><Icon name="camera" /></span>
          <span class="ig-field">Повідомлення…</span>
          <Icon name="microphone" />
          <Icon name="image" />
          <Icon name="sticker" />
        </div>
      </figure>

      <!-- The same sale in Cartium: three actions and the paid order in between. -->
      <article class="cart" data-cart aria-labelledby="cart-title">
        <div class="aura story-aura" data-story-aura aria-hidden="true"></div>
        <header class="cart-head">
          <p class="cart-title" id="cart-title">Той самий продаж у&nbsp;Cartium</p>
          <p class="cart-span">з 10:02 до 10:05</p>
        </header>
        <ol class="cart-steps">
          {actions.slice(0, 2).map((a, i) => (
            <li class="cart-step" data-cart-step>
              <span class="cart-num">{i + 1}</span>
              <span class="cart-body">
                <span class="cart-who"><Icon name={a.icon} /> {a.who}, {a.time}</span>
                <span class="cart-text">{a.text}</span>
              </span>
            </li>
          ))}
          <li class="cart-order" data-cart-step>
            <p class="cart-who cart-who--auto"><Icon name="check-circle-fill" /> Без вашої участі, 10:04</p>
            <article class="order paper" aria-label="Замовлення в Cartium">
              <header class="order-head">
                <span class="order-num">#55</span>
                <span class="order-status"><Icon name="check-circle-fill" /> Оплачено</span>
              </header>
              <div class="order-row">
                <span class="order-thumb"><Image src={teePhoto} alt="" width={112} quality={82} /></span>
                <div class="order-item">
                  <p class="order-title">Футболка, чорна</p>
                  <p class="order-meta">Розмір M · Нова пошта, Київ, №12</p>
                </div>
                <p class="order-sum">1 500 грн</p>
              </div>
            </article>
          </li>
          <li class="cart-step cart-step--last" data-cart-step>
            <span class="cart-num">3</span>
            <span class="cart-body">
              <span class="cart-who"><Icon name="truck" /> {actions[2].who}, {actions[2].time}</span>
              <span class="cart-text">{actions[2].text}</span>
            </span>
            <span class="cart-ttn">ТТН 20451386942762</span>
          </li>
        </ol>
        <p class="cart-foot" data-cart-step>Ваших повідомлень: 0</p>
      </article>
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: clamp(72px, 9vw, 128px);
  }
  /* One screen: the claim on the left, the two versions of the sale beside it. */
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.16fr) minmax(0, 0.94fr);
    align-items: stretch;
    gap: clamp(20px, 2.6vw, 40px);
  }
  .story-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(20px, 2.4vw, 32px);
  }
  .story-head {
    display: grid;
    gap: 16px;
  }
  .story-head .h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 1.2rem + 2.2vw, 3.2rem);
  }
  .story-head .lead {
    max-width: 34ch;
    font-size: 1.02rem;
  }
  .story-claim {
    display: grid;
    gap: 4px;
    padding-top: clamp(16px, 2vw, 24px);
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .claim-line {
    display: block;
    color: var(--ink-2);
  }
  .claim-line b {
    color: var(--ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .claim-line--cartium,
  .claim-line--cartium b {
    color: var(--accent-text);
  }
  .story-note {
    max-width: 32ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  /* ---------- Instagram Direct, dark ----------
     Its own palette, the way a screenshot of another app keeps its colours. --ig-fs scales the
     whole chat so all fourteen messages fit under the nav on a laptop. */
  .ig {
    --ig-fs: clamp(11px, calc((100svh - 330px) / 35), 14px);
    --ig-sent-a: #a033ff;
    --ig-sent-b: #1a8cff;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    border-radius: 30px;
    background: #000;
    color: #f5f5f5;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: var(--ig-fs);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 40px 90px -50px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }
  .ig-head {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.8em 1.1em;
    border-bottom: 1px solid #262626;
  }
  .ig-head > :global(.icon) {
    font-size: 1.6em;
  }
  .ig-avatar,
  .ig-face {
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
    background: linear-gradient(135deg, #5e5e5e, #2e2e2e);
    color: #fff;
    font-weight: 600;
  }
  .ig-avatar {
    width: 2.4em;
    height: 2.4em;
  }
  .ig-who {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }
  .ig-name {
    font-weight: 600;
  }
  .ig-sub {
    color: #a8a8a8;
    font-size: 0.88em;
  }
  .ig-tools {
    display: flex;
    gap: 1em;
    margin-left: auto;
    font-size: 1.55em;
  }
  .ig-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.5em 0.9em 0.4em;
  }
  .ig-stamp {
    align-self: center;
    margin: 0.35em 0 0.3em;
    color: #a8a8a8;
    font-size: 0.82em;
    font-weight: 500;
  }
  .ig-msg {
    display: flex;
    align-items: flex-end;
    gap: 0.5em;
    max-width: 88%;
    margin-top: 2px;
  }
  .ig-msg.is-end {
    margin-bottom: 6px;
  }
  .ig-msg--them {
    align-self: flex-start;
  }
  .ig-msg--me {
    align-self: flex-end;
  }
  .ig-text {
    padding: 0.42em 0.9em;
    border-radius: 1.25em;
    line-height: 1.3;
  }
  .ig-msg--them .ig-text {
    background: #262626;
  }
  .ig-msg--me .ig-text {
    background: color-mix(in oklab, var(--ig-sent-a), var(--ig-sent-b) calc(var(--tone) * 100%));
    color: #fff;
  }
  /* The tiny avatar sits beside the last bubble of each of her groups only. */
  .ig-face {
    width: 1.75em;
    height: 1.75em;
    font-size: 0.78em;
    visibility: hidden;
  }
  .ig-msg--them.is-end .ig-face {
    visibility: visible;
  }
  .ig-shot {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 3.2em;
    border-radius: 0.9em;
    background: #f2f2f2;
  }
  .ig-shot-lines {
    display: grid;
    gap: 0.28em;
    width: 60%;
  }
  .ig-shot-lines i {
    display: block;
    height: 0.28em;
    border-radius: 1px;
    background: #c9c9c9;
  }
  .ig-shot-lines i:nth-child(2) {
    width: 70%;
    background: #111;
  }
  .ig-compose {
    display: flex;
    align-items: center;
    gap: 0.75em;
    margin: 0.2em 0.8em 0.85em;
    padding: 0.35em 0.9em 0.35em 0.35em;
    border-radius: 2em;
    background: #262626;
    color: #f5f5f5;
  }
  .ig-compose > :global(.icon) {
    font-size: 1.35em;
  }
  .ig-cam {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: #3797f0;
    font-size: 1.05em;
  }
  .ig-field {
    flex: 1;
    color: #a8a8a8;
  }

  /* ---------- Cartium ---------- */
  .cart {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: clamp(18px, 2vw, 26px);
    border-radius: 30px;
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent),
      0 40px 90px -50px var(--accent-glow);
  }
  .story-aura {
    z-index: -1;
    --aura-o: var(--stage-glow, 1);
    --aura-boost: 30%;
    left: -30%;
    top: -20%;
    width: 160%;
    aspect-ratio: 1 / 1;
  }
  .cart-head {
    display: grid;
    gap: 2px;
  }
  .cart-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .cart-span {
    color: var(--muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }
  .cart-steps {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .cart-step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 6px 14px;
  }
  .cart-num {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
  }
  .cart-body {
    display: grid;
    gap: 2px;
  }
  .cart-who {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .cart-who--auto {
    margin-bottom: 8px;
    padding-left: 48px;
    color: var(--ok);
  }
  .cart-text {
    font-weight: 600;
    line-height: 1.3;
  }
  .cart-ttn {
    grid-column: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    padding: 7px 14px;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.82rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 14px 30px -14px var(--accent-glow);
  }
  .cart-foot {
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-weight: 600;
  }
  .order {
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: 20px;
    box-shadow: 0 30px 80px -40px rgba(255, 255, 255, 0.22);
  }
  .order-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .order-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.03em;
  }
  .order-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px 4px 8px;
    border-radius: var(--r-pill);
    background: var(--ok-soft);
    color: var(--ok);
    font-weight: 600;
    font-size: 0.8rem;
  }
  .order-row {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }
  .order-thumb {
    display: block;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: #2a2a2a;
    overflow: hidden;
  }
  .order-thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .order-title {
    font-weight: 600;
    font-size: 0.92rem;
  }
  .order-meta {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .order-sum {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Tablets: the claim runs across the top, the two sales sit side by side under it. */
  @media (max-width: 1180px) {
    .story-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .story-copy {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      gap: 20px 40px;
    }
    .story-head {
      grid-row: 1 / span 2;
    }
    .story-claim {
      padding-top: 0;
      border-top: 0;
    }
    .ig {
      --ig-fs: 13px;
    }
  }

  /* Phones: one column, the chat first so its length is felt before Cartium's three steps. */
  @media (max-width: 720px) {
    .story-grid,
    .story-copy {
      grid-template-columns: minmax(0, 1fr);
    }
    .story-head {
      grid-row: auto;
    }
    .story-claim {
      padding-top: 18px;
      border-top: 1px solid var(--line);
    }
    .ig {
      --ig-fs: 13px;
      border-radius: 26px;
    }
    .cart {
      border-radius: 26px;
    }
  }
</style>
